---
export interface Props {
  phoneNumber?: string;
  message?: string;
}

const {
  phoneNumber = '5492944486303',
  message = 'Hola, quisiera consultar por las propiedades en Añelo...',
} = Astro.props;

const waUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
---

<a
  href={waUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-40 flex items-center gap-3 p-3.5 bg-emerald-500 hover:bg-emerald-400 text-white rounded-full shadow-2xl shadow-emerald-500/40 transition-all duration-300 hover:scale-110 active:scale-95 group"
  aria-label="Consultar por WhatsApp"
>
  <span class="absolute -inset-1 rounded-full bg-emerald-400/40 animate-ping pointer-events-none"></span>
  <svg class="w-7 h-7 fill-current relative z-10" viewBox="0 0 24 24">
    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z"/>
  </svg>
  <span class="hidden md:inline-block pr-1 text-xs uppercase tracking-wider font-bold relative z-10 whitespace-nowrap">
    Consultar
  </span>
</a>
