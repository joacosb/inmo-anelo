---
import { getSiteContent } from '../lib/site-content';

export interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

// Memoizado por request en el middleware. Las páginas prerenderizadas no pasan
// por ahí, así que caemos a la consulta directa (en build time, en ese caso).
const { destinoVacio } = Astro.locals.siteContent
  ? await Astro.locals.siteContent()
  : await getSiteContent();

const navItemsBase = [
  {
    href: '/',
    label: 'Inicio',
    active: pathname === '/',
    sublinks: [
      { href: '/#por-que-anelo', label: 'Vaca Muerta' },
      { href: '/#nuestros-complejos', label: 'Nuestros complejos' },
      { href: '/#como-invierto', label: '¿Cómo invierto?' },
    ],
  },
  {
    href: '/corporativo/',
    label: 'Alquiler Corporativo',
    active: pathname === '/corporativo/',
    sublinks: [
      { href: '/corporativo/#secComplejos', label: 'Complejos residenciales' },
      { href: '/corporativo/#secEdificios', label: 'Edificios y locales' },
    ],
  },
  {
    href: '/venta/',
    label: 'Comprar',
    active: pathname.startsWith('/venta/'),
    sublinks: [
      { href: '/venta/?tipo=casa', label: 'Casas en venta' },
      { href: '/venta/?tipo=departamento', label: 'Departamentos' },
      { href: '/venta/?tipo=terreno', label: 'Terrenos' },
    ],
  },
  // Alquiler permanente es su propia sección: antes colgaba de "Comprar", que
  // no corresponde. /alquiler/ usa el mismo ListingsBrowser que /venta/, así
  // que los ?tipo= funcionan igual.
  {
    href: '/alquiler/',
    label: 'Alquiler Permanente',
    active: pathname.startsWith('/alquiler/'),
    sublinks: [
      { href: '/alquiler/?tipo=casa', label: 'Casas en alquiler' },
      { href: '/alquiler/?tipo=departamento', label: 'Departamentos' },
      { href: '/alquiler/?tipo=local', label: 'Locales comerciales' },
    ],
  },
  {
    href: '/invertir/',
    label: 'Invertir',
    active: pathname === '/invertir/',
    sublinks: [
      { href: '/invertir/#retornos', label: 'Rentabilidad en USD' },
      { href: '/invertir/#propiedades', label: 'Propiedades disponibles' },
      { href: '/invertir/#faq', label: 'Preguntas frecuentes' },
    ],
  },
  {
    href: '/nosotros/',
    label: 'Nosotros',
    active: pathname === '/nosotros/',
  },
];

/*
 * Un sublink a una sección que quedó vacía deja al visitante arriba de la
 * página, sin lo que fue a buscar. Se saca del menú hasta que vuelva a haber
 * contenido. El link principal del item nunca se toca: /corporativo/ sigue
 * siendo una página válida aunque una de sus subsecciones esté vacía.
 *
 * `sublinks` queda en `undefined` y no en `[]` a propósito: un array vacío es
 * truthy y dejaría el chevron y el dropdown colgados sin nada adentro.
 */
const navItems = navItemsBase.map((item) => {
  if (!item.sublinks) return item;
  const sublinks = item.sublinks.filter((sub) => !destinoVacio(sub.href));
  return { ...item, sublinks: sublinks.length > 0 ? sublinks : undefined };
});
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 h-[var(--nav-h)] bg-brand-black/95 backdrop-blur-xl border-b border-brand-gold/30 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between">
    
    <!-- Prominent Brand Logo & Name -->
    <a href="/" class="flex items-center gap-4 group">
      <div class="relative flex items-center justify-center">
        <div class="absolute -inset-1.5 bg-gradient-to-r from-brand-gold via-brand-gold-light to-brand-terra rounded-full blur-sm opacity-30 group-hover:opacity-100 transition-opacity duration-300"></div>
        <img src="/favicon.svg" alt="Inmobiliaria Añelo" class="relative w-12 h-12 object-contain transition-transform duration-300 group-hover:scale-105" width="48" height="48" />
      </div>
      <div class="flex flex-col leading-tight">
        <span class="text-[11px] tracking-[0.25em] uppercase font-bold text-brand-gold">Inmobiliaria</span>
        <span class="text-xl sm:text-2xl font-bold tracking-wider text-white font-display group-hover:text-brand-gold-light transition-colors">AÑELO</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <ul class="hidden xl:flex items-center gap-4 2xl:gap-6" id="navLinks">
      {navItems.map((item) => (
        <li class="relative group">
          <div class="flex items-center gap-1">
            <a
              href={item.href}
              class={`text-xs uppercase tracking-widest font-semibold py-2 transition-colors duration-200 ${
                item.active ? 'text-brand-gold font-bold' : 'text-stone-300 hover:text-brand-gold'
              }`}
            >
              {item.label}
            </a>
            {item.sublinks && (
              <button
                class="nav-chevron-btn p-1 text-stone-400 hover:text-brand-gold transition-transform duration-200 group-hover:rotate-180"
                aria-label={`Desplegar submenú ${item.label}`}
                aria-expanded="false"
              >
                <svg class="w-3 h-3" viewBox="0 0 10 6" fill="none">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            )}
          </div>

          {item.sublinks && (
            <div class="nav-dropdown absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50 min-w-[220px]">
              <div class="bg-stone-900 border border-brand-gold/40 rounded-xl p-2.5 shadow-2xl shadow-black space-y-1">
                {item.sublinks.map((sub) => (
                  <a
                    href={sub.href}
                    class="block px-3.5 py-2.5 text-xs text-stone-300 hover:text-brand-gold hover:bg-stone-800 rounded-lg transition-colors font-medium"
                  >
                    {sub.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </li>
      ))}

      <!-- Prominent Contact CTA Button -->
      <li>
        <a
          href="/contacto/"
          class="inline-flex items-center px-5 py-2.5 text-xs uppercase tracking-widest font-bold text-brand-black bg-brand-gold hover:bg-brand-gold-light rounded-lg shadow-lg shadow-brand-gold/25 transition-all duration-200 hover:scale-105 active:scale-95"
        >
          Contacto
        </a>
      </li>
    </ul>

    <!-- Mobile Hamburger Button -->
    <button
      id="hamburgerBtn"
      class="xl:hidden p-2.5 text-stone-300 hover:text-brand-gold"
      aria-label="Abrir menú de navegación"
    >
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobileDrawer"
    class="hidden xl:hidden fixed top-[var(--nav-h)] left-0 right-0 max-h-[calc(100vh-var(--nav-h))] overflow-y-auto bg-brand-black border-b border-brand-gold/30 px-6 py-8 space-y-6"
  >
    {navItems.map((item) => (
      <div class="space-y-2">
        <a
          href={item.href}
          class={`block text-base uppercase tracking-wider font-semibold ${
            item.active ? 'text-brand-gold' : 'text-stone-200'
          }`}
        >
          {item.label}
        </a>
        {item.sublinks && (
          <div class="pl-4 space-y-2 border-l border-brand-gold/30">
            {item.sublinks.map((sub) => (
              <a href={sub.href} class="block text-xs text-stone-400 hover:text-brand-gold py-1 font-medium">
                {sub.label}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
    <a
      href="/contacto/"
      class="block text-center w-full py-3.5 text-xs uppercase tracking-widest font-bold text-brand-black bg-brand-gold rounded-lg shadow-lg"
    >
      Contacto
    </a>
  </div>
</nav>

<script>
  // Mobile drawer toggle script
  const hamburgerBtn = document.getElementById('hamburgerBtn');
  const mobileDrawer = document.getElementById('mobileDrawer');

  if (hamburgerBtn && mobileDrawer) {
    hamburgerBtn.addEventListener('click', () => {
      mobileDrawer.classList.toggle('hidden');
    });
  }
</script>
