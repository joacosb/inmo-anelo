---
/**
 * Ficha de detalle de una propiedad, compartida por /venta/[slug] y
 * /alquiler/[slug].
 */
import {
  getImageUrl, getSrcSet, formatPrice, formatExpenses, specLine, locationLabel,
  operationStatusLabel, operationStatusClass, propKindLabel, featureLabel,
} from '../lib/supabase';
import type { Property, Operation } from '../lib/supabase';

interface Props {
  p:  Property;
  op: Operation;
}
const { p, op } = Astro.props;

const isSale = op === 'venta';
const photos = (p.images?.length ? p.images : (p.cover_image ? [p.cover_image] : []));
const positions = photos.map((url, i) =>
  (p.image_positions ?? [])[i] ?? (url === p.cover_image ? (p.cover_position ?? '50% 50%') : '50% 50%')
);

const price = formatPrice(p, op);
const expenses = formatExpenses(p);
const hasPoint = p.lat != null && p.lng != null;

const waText = encodeURIComponent(
  `Hola, me interesa "${p.name}" (${isSale ? 'venta' : 'alquiler'}) que vi en la web. ¿Me pasás más información?`
);
const waUrl = `https://wa.me/5492944486303?text=${waText}`;

// Ficha técnica: sólo las filas con dato cargado.
const specs = [
  { label: 'Tipo',          value: p.prop_type ? propKindLabel(p.prop_type) : null },
  { label: 'Ambientes',     value: p.rooms },
  { label: 'Dormitorios',   value: p.bedrooms },
  { label: 'Baños',         value: p.bathrooms },
  { label: 'Cocheras',      value: p.parking },
  { label: 'm² cubiertos',  value: p.area_covered },
  { label: 'm² totales',    value: p.area_total },
  { label: 'Zona',          value: locationLabel(p) },
].filter((s) => s.value != null && s.value !== '');

// Schema.org
const numericPrice = isSale ? p.sale_price : p.rent_price;
const showPrice = !(isSale && p.sale_price_hidden) && numericPrice != null;
const jsonLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: p.name,
  description: p.description ?? undefined,
  url: new URL(`/${op}/${p.slug}/`, Astro.site ?? 'https://inmobiliariaanelo.com.ar').href,
  image: photos.map((u) => getImageUrl(u, { width: 1200 })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Añelo',
    addressRegion: 'Neuquén',
    addressCountry: 'AR',
  },
};
if (p.area_covered ?? p.area_total) {
  jsonLd.floorSize = { '@type': 'QuantitativeValue', value: p.area_covered ?? p.area_total, unitCode: 'MTK' };
}
if (p.bedrooms) jsonLd.numberOfBedrooms = p.bedrooms;
if (p.bathrooms) jsonLd.numberOfBathroomsTotal = p.bathrooms;
if (showPrice) {
  jsonLd.offers = {
    '@type': 'Offer',
    price: numericPrice,
    priceCurrency: isSale ? p.sale_currency : p.rent_currency,
    availability: (isSale ? p.sale_status : p.rent_status) === 'available'
      ? 'https://schema.org/InStock'
      : 'https://schema.org/SoldOut',
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<div class="bg-brand-black text-white min-h-screen py-8 pb-24 border-t border-stone-800/80">
  <article class="ld">
    <!-- Migas de pan / Breadcrumbs -->
    <div class="ld-crumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span class="ld-sep">/</span>
      <a href={`/${op}/`}>{isSale ? 'Venta' : 'Alquiler'}</a>
      <span class="ld-sep">/</span>
      <span class="ld-crumb-current">{p.name}</span>
    </div>

    <div class="ld-grid">
      <!-- ── GALERÍA ──────────────────────────────────────────────────── -->
      <div class="ld-gallery">
        {photos.length > 0 ? (
          <>
            <div class="ld-stage">
              <img id="ldMain"
                src={getImageUrl(photos[0], { width: 1200 })}
                srcset={getSrcSet(photos[0], [640, 1080, 1200])}
                sizes="(max-width: 900px) 100vw, 760px"
                alt={p.name} width="1200" height="800" fetchpriority="high" decoding="async"
                style={`object-position:${positions[0]}`} />
              {photos.length > 1 && (
                <>
                  <button class="ld-nav ld-prev" id="ldPrev" aria-label="Foto anterior">‹</button>
                  <button class="ld-nav ld-next" id="ldNext" aria-label="Foto siguiente">›</button>
                  <span class="ld-counter"><span id="ldIdx">1</span> / {photos.length}</span>
                </>
              )}
            </div>
            {photos.length > 1 && (
              <div class="ld-thumbs" id="ldThumbs">
                {photos.map((url, i) => (
                  <button class={`ld-thumb ${i === 0 ? 'active' : ''}`} data-i={i} aria-label={`Ver foto ${i + 1}`}>
                    <img src={getImageUrl(url, { width: 256 })} alt="" width="256" height="192"
                      loading="lazy" decoding="async" style={`object-position:${positions[i]}`} />
                  </button>
                ))}
              </div>
            )}
          </>
        ) : (
          <div class="ld-stage ld-stage-empty">Sin fotos cargadas</div>
        )}
      </div>

      <!-- ── SIDEBAR INFO ─────────────────────────────────────────────── -->
      <aside class="ld-info">
        <span class={`ld-badge ${operationStatusClass(p, op)}`}>{operationStatusLabel(p, op)}</span>

        <div class="ld-price">{price}</div>
        {expenses && <div class="ld-expenses">{expenses}</div>}

        <h1 class="ld-title">{p.name}</h1>
        {specLine(p) && <div class="ld-specline">{specLine(p)}</div>}
        <div class="ld-location">
          <i data-lucide="map-pin"></i>{locationLabel(p)}, Añelo — Neuquén
        </div>

        <div class="ld-actions">
          <a class="ld-btn ld-btn-wa" href={waUrl} target="_blank" rel="noopener">
            <i data-lucide="message-circle"></i>Consultar por WhatsApp
          </a>
          {p.matterport_url && (
            <a class="ld-btn ld-btn-ghost" href={p.matterport_url} target="_blank" rel="noopener">
              <i data-lucide="box"></i>Recorrido virtual 360°
            </a>
          )}
        </div>

        {specs.length > 0 && (
          <div class="ld-block">
            <h2 class="ld-block-title">Ficha técnica</h2>
            <dl class="ld-specs">
              {specs.map((s) => (
                <div class="ld-spec-row">
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {(p.features ?? []).length > 0 && (
          <div class="ld-block">
            <h2 class="ld-block-title">Características</h2>
            <ul class="ld-features">
              {(p.features ?? []).map((f) => (
                <li><i data-lucide="check"></i>{featureLabel(f)}</li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    <!-- ── DESCRIPCIÓN ─────────────────────────────────────────────── -->
    {p.description && (
      <section class="ld-block ld-desc">
        <h2 class="ld-block-title">Descripción</h2>
        <div class="ld-desc-text">
          <p>{p.description}</p>
        </div>
      </section>
    )}

    <!-- ── MAPA ─────────────────────────────────────────────────────── -->
    {hasPoint && (
      <section class="ld-block">
        <h2 class="ld-block-title">Ubicación</h2>
        <div id="ldMap"></div>
        {!p.location_exact && (
          <p class="ld-map-note">
            El círculo indica la zona aproximada (radio de 300 m).
            Coordinamos la dirección exacta al agendar la visita.
          </p>
        )}
      </section>
    )}

    <!-- ── CTA FINAL ────────────────────────────────────────────────── -->
    <section class="ld-cta">
      <h2>¿Te interesa esta propiedad?</h2>
      <p>Escribinos y coordinamos una visita.</p>
      <a class="ld-btn ld-btn-wa" href={waUrl} target="_blank" rel="noopener">
        <i data-lucide="message-circle"></i>Consultar por WhatsApp
      </a>
    </section>
  </article>
</div>

<style is:global>
  .ld { max-width: 1300px; margin: 0 auto; padding: 0 1.5rem 2rem; color: #ffffff; }

  /* ── BREADCRUMBS ── */
  .ld-crumbs {
    display: flex; gap: .6rem; align-items: center;
    font-size: .8rem; color: rgba(255,255,255,.5);
    margin-bottom: 2rem; flex-wrap: wrap; font-weight: 500;
  }
  .ld-crumbs a { color: rgba(255,255,255,.75); text-decoration: none; transition: color .15s; }
  .ld-crumbs a:hover { color: var(--gold, #c9a84c); }
  .ld-sep { color: rgba(255,255,255,.3); }
  .ld-crumb-current { color: var(--gold, #c9a84c); font-weight: 600; }

  .ld-grid { display: grid; grid-template-columns: 1fr 420px; gap: 2.5rem; align-items: start; }

  /* ── GALERÍA ───────────────────────────────────────────────────────── */
  .ld-stage {
    position: relative; aspect-ratio: 16/10; border-radius: 16px;
    overflow: hidden; background: #141412; border: 1px solid rgba(255,255,255,.1);
    box-shadow: 0 8px 32px rgba(0,0,0,.5);
  }
  .ld-stage img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity .2s ease; }
  .ld-stage-empty { display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.3); font-size: .9rem; }
  .ld-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    background: rgba(0,0,0,.6); border: 1px solid rgba(255,255,255,.2); color: #fff;
    font-size: 1.8rem; line-height: 1; width: 48px; height: 48px; border-radius: 50%;
    cursor: pointer; transition: background .2s, border-color .2s; z-index: 5;
    display: flex; align-items: center; justify-content: center;
  }
  .ld-nav:hover { background: var(--gold, #c9a84c); border-color: var(--gold, #c9a84c); color: #000; }
  .ld-prev { left: 1rem; }
  .ld-next { right: 1rem; }
  .ld-counter {
    position: absolute; bottom: 1rem; right: 1rem;
    background: rgba(0,0,0,.75); backdrop-filter: blur(4px); color: #fff; font-size: .75rem;
    padding: .3rem .8rem; border-radius: 20px; font-weight: 600; border: 1px solid rgba(255,255,255,.15);
  }
  .ld-thumbs { display: flex; gap: .65rem; overflow-x: auto; padding: 1rem 0 .25rem; scrollbar-width: thin; }
  .ld-thumb {
    flex: 0 0 100px; height: 72px; padding: 0; border: 2px solid transparent;
    border-radius: 10px; overflow: hidden; background: #141412; cursor: pointer;
    transition: border-color .2s, opacity .2s, transform .2s; opacity: .5;
  }
  .ld-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ld-thumb:hover { opacity: .85; transform: translateY(-1px); }
  .ld-thumb.active { border-color: var(--gold, #c9a84c); opacity: 1; box-shadow: 0 4px 12px rgba(201,168,76,.25); }

  /* ── INFO (TARJETA LATERAL LUXURY) ────────────────────────────────── */
  .ld-info {
    background: #242420; border: 1px solid rgba(201,168,76,.3);
    border-radius: 16px; padding: 2rem 1.8rem; position: sticky; top: 110px;
    box-shadow: 0 12px 36px rgba(0,0,0,.5); color: #ffffff;
  }
  .ld-badge {
    display: inline-block; font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    padding: .3rem .8rem; border-radius: 20px; color: #fff; margin-bottom: 1rem;
  }
  .ld-badge.disponible { background: rgba(16,185,129,.92); }
  .ld-badge.parcialmente-ocupado { background: rgba(245,158,11,.92); color: #000; }
  .ld-badge.ocupado { background: rgba(239,68,68,.92); }
  .ld-price { font-size: 2.2rem; font-weight: 700; color: var(--gold, #c9a84c); line-height: 1.1; letter-spacing: -.01em; }
  .ld-expenses { font-size: .8rem; color: rgba(255,255,255,.5); margin-top: .3rem; }
  .ld-title { font-family: var(--font-display); font-size: 2rem; font-weight: 600; margin: 1rem 0 .6rem; line-height: 1.2; color: #ffffff; }
  .ld-specline { font-size: .9rem; color: rgba(255,255,255,.75); margin-bottom: .6rem; }
  .ld-location { display: flex; align-items: center; gap: .4rem; font-size: .85rem; color: rgba(255,255,255,.55); font-weight: 500; }
  .ld-location i { width: 16px; height: 16px; flex-shrink: 0; color: var(--gold, #c9a84c); }

  .ld-actions { display: flex; flex-direction: column; gap: .75rem; margin: 1.75rem 0; }
  .ld-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .6rem;
    font-size: .85rem; font-weight: 700; text-decoration: none; text-transform: uppercase; letter-spacing: .06em;
    padding: .9rem 1.4rem; border-radius: 8px; transition: background .2s, border-color .2s, transform .15s;
    box-shadow: 0 4px 14px rgba(0,0,0,.3);
  }
  .ld-btn i { width: 18px; height: 18px; }
  .ld-btn-wa { background: #25d366; color: #000000; }
  .ld-btn-wa:hover { background: #34d399; transform: translateY(-1px); }
  .ld-btn-ghost { border: 1.5px solid rgba(201,168,76,.45); color: var(--gold, #c9a84c); background: transparent; }
  .ld-btn-ghost:hover { background: rgba(201,168,76,.15); border-color: var(--gold, #c9a84c); }

  .ld-block { margin-top: 2.25rem; }
  .ld-block-title {
    font-size: .72rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
    color: var(--gold, #c9a84c); padding-bottom: .65rem; margin-bottom: 1.1rem;
    border-bottom: 1px solid rgba(201,168,76,.25);
  }
  .ld-specs { display: grid; gap: .2rem; }
  .ld-spec-row { display: flex; justify-content: space-between; gap: 1rem; padding: .6rem 0; border-bottom: 1px solid rgba(255,255,255,.08); font-size: .85rem; }
  .ld-spec-row dt { color: rgba(255,255,255,.55); }
  .ld-spec-row dd { color: #ffffff; font-weight: 600; text-align: right; }
  .ld-features { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: .6rem .85rem; }
  .ld-features li { display: flex; align-items: center; gap: .45rem; font-size: .82rem; color: rgba(255,255,255,.8); font-weight: 500; }
  .ld-features i { color: var(--gold, #c9a84c); width: 16px; height: 16px; flex-shrink: 0; }

  /* ── DESCRIPCIÓN Y MAPA ── */
  .ld-desc { background: #242420; border: 1px solid rgba(255,255,255,.1); border-radius: 16px; padding: 2rem; margin-top: 3rem; }
  .ld-desc-text p { font-size: 1rem; line-height: 1.8; color: rgba(255,255,255,.85); white-space: pre-line; max-width: 80ch; font-weight: 300; }

  #ldMap { height: 420px; border-radius: 16px; border: 1px solid rgba(201,168,76,.3); margin-top: 1rem; box-shadow: 0 8px 32px rgba(0,0,0,.4); }
  .ld-map-note { font-size: .78rem; color: rgba(255,255,255,.5); margin-top: .75rem; line-height: 1.6; }

  .ld-cta {
    text-align: center; margin-top: 4rem; padding: 3.5rem 2rem;
    background: #242420; border: 1px solid rgba(201,168,76,.3); border-radius: 16px;
    box-shadow: 0 12px 36px rgba(0,0,0,.4);
  }
  .ld-cta h2 { font-family: var(--font-display); font-size: 2.2rem; font-weight: 600; color: #ffffff; margin-bottom: .5rem; }
  .ld-cta p { font-size: .95rem; color: rgba(255,255,255,.6); margin-bottom: 1.75rem; font-weight: 300; }
  .ld-cta .ld-btn { display: inline-flex; }

  @media (max-width: 1024px) {
    .ld-grid { grid-template-columns: 1fr; }
    .ld-info { position: static; }
    .ld-price { font-size: 1.9rem; }
    .ld-features { grid-template-columns: 1fr; }
  }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script is:inline define:vars={{
  photos: photos.map((u) => getImageUrl(u, { width: 1200 })),
  positions,
  lat: p.lat, lng: p.lng, exact: p.location_exact, hasPoint, name: p.name,
}}>
(function () {
  /* ── Carrusel ───────────────────────────────────────────────────── */
  var main = document.getElementById('ldMain');
  if (main && photos.length > 1) {
    var idx = 0;
    var idxEl = document.getElementById('ldIdx');
    var thumbs = Array.prototype.slice.call(document.querySelectorAll('.ld-thumb'));

    // Precarga
    photos.forEach(function (src) { var i = new Image(); i.src = src; });

    function show(n) {
      idx = (n + photos.length) % photos.length;
      main.style.opacity = '0';
      setTimeout(function () {
        main.src = photos[idx];
        main.srcset = '';
        main.style.objectPosition = positions[idx] || '50% 50%';
        main.style.opacity = '1';
      }, 90);
      if (idxEl) idxEl.textContent = idx + 1;
      thumbs.forEach(function (t, i) { t.classList.toggle('active', i === idx); });
    }

    document.getElementById('ldPrev').addEventListener('click', function () { show(idx - 1); });
    document.getElementById('ldNext').addEventListener('click', function () { show(idx + 1); });
    thumbs.forEach(function (t) {
      t.addEventListener('click', function () { show(Number(t.dataset.i)); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft')  show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
  }

  /* ── Mapa ───────────────────────────────────────────────────────── */
  if (!hasPoint || typeof L === 'undefined') return;
  var el = document.getElementById('ldMap');
  if (!el) return;

  var map = L.map(el, { scrollWheelZoom: false }).setView([lat, lng], exact ? 17 : 15);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
    attribution: '© OpenStreetMap · © CARTO', maxZoom: 19,
  }).addTo(map);

  if (exact) {
    L.marker([lat, lng]).addTo(map).bindPopup(name);
  } else {
    L.circle([lat, lng], {
      radius: 300, color: '#c9a84c', weight: 2, fillColor: '#c9a84c', fillOpacity: .15,
    }).addTo(map);
  }
})();
</script>
