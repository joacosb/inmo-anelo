---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
---
<Layout
  title="Contacto | Cotizá tu Alquiler en 24hs - Inmobiliaria Añelo"
  description="Contactanos para alquiler corporativo o inversión en Añelo, Neuquén. Respuesta en menos de 24 horas. WhatsApp +54 9 2944 486303. Vaca Muerta 8305, Añelo."
  pathname="/contacto/"
>

  <section class="py-16 sm:py-24 bg-brand-black text-white min-h-[calc(100vh-88px)] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <SectionHeader
        subtitle="Contacto Directo"
        title="Hablemos de tu proyecto"
        description="Ya sea que quieras invertir, alquilar para tu empresa o realizar una consulta general, te responderemos en menos de 24 horas."
        align="center"
      />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left: Contact Details & Hours (5 cols) -->
        <div class="lg:col-span-5 bg-stone-900/80 border border-stone-800 p-6 sm:p-8 rounded-2xl space-y-8 shadow-xl">
          <div>
            <h3 class="font-display text-2xl font-semibold text-white mb-2">Información de Contacto</h3>
            <p class="text-xs sm:text-sm text-stone-400 font-light leading-relaxed">
              Atención personalizada para empresas, inversores y particulares.
            </p>
          </div>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center shrink-0 border border-brand-gold/30">
                <i data-lucide="smartphone" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="block text-[10px] uppercase tracking-widest font-bold text-stone-400">Teléfono / WhatsApp</span>
                <a href="tel:+5492944486303" class="text-base font-semibold text-white hover:text-brand-gold transition-colors">+54 9 2944 486303</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center shrink-0 border border-brand-gold/30">
                <i data-lucide="mail" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="block text-[10px] uppercase tracking-widest font-bold text-stone-400">Email</span>
                <a href="mailto:grupopampanqn@gmail.com" class="text-base font-semibold text-white hover:text-brand-gold transition-colors">grupopampanqn@gmail.com</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center shrink-0 border border-brand-gold/30">
                <i data-lucide="map-pin" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="block text-[10px] uppercase tracking-widest font-bold text-stone-400">Oficina Añelo</span>
                <span class="text-sm text-stone-200">Vaca Muerta 8305, Añelo, Neuquén</span>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center shrink-0 border border-brand-gold/30">
                <i data-lucide="at-sign" class="w-5 h-5"></i>
              </div>
              <div>
                <span class="block text-[10px] uppercase tracking-widest font-bold text-stone-400">Redes Sociales</span>
                <a href="https://www.instagram.com/inmobiliaria.anelo" target="_blank" rel="noopener" class="text-sm font-semibold text-white hover:text-brand-gold transition-colors">@inmobiliaria.anelo</a>
              </div>
            </div>
          </div>

          <div class="p-5 bg-stone-950 border border-stone-800 rounded-xl space-y-2">
            <span class="block text-brand-gold text-[11px] tracking-widest uppercase font-bold">Horarios de Atención</span>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              Lunes a Viernes: 9:00 – 18:00 hs<br/>
              Sábados: 9:00 – 13:00 hs
            </p>
          </div>
        </div>

        <!-- Right: Orderly Form (7 cols) -->
        <div class="lg:col-span-7 bg-stone-900/90 border border-stone-800 p-6 sm:p-10 rounded-2xl shadow-2xl space-y-6">
          <div>
            <h3 class="font-display text-2xl sm:text-3xl font-semibold text-white mb-2">Cotizá o Enviar Consulta</h3>
            <p class="text-xs sm:text-sm text-stone-400 font-light">Completá los campos a continuación y te responderemos por WhatsApp o Email.</p>
          </div>

          <form id="contactForm" class="space-y-5" novalidate>
            <!-- Row 1: First & Last Name -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="fNombre" class="block text-xs uppercase tracking-wider font-semibold text-stone-300">Nombre *</label>
                <input type="text" id="fNombre" name="first_name" placeholder="Tu nombre" autocomplete="given-name" required class="w-full px-4 py-3 bg-stone-950 border border-stone-800 focus:border-brand-gold rounded-xl text-sm text-white focus:outline-none transition-colors" />
              </div>
              <div class="space-y-2">
                <label for="fApellido" class="block text-xs uppercase tracking-wider font-semibold text-stone-300">Apellido</label>
                <input type="text" id="fApellido" name="last_name" placeholder="Tu apellido" autocomplete="family-name" class="w-full px-4 py-3 bg-stone-950 border border-stone-800 focus:border-brand-gold rounded-xl text-sm text-white focus:outline-none transition-colors" />
              </div>
            </div>

            <!-- Row 2: Email & Phone -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="fEmail" class="block text-xs uppercase tracking-wider font-semibold text-stone-300">Email *</label>
                <input type="email" id="fEmail" name="email" placeholder="tu@empresa.com" autocomplete="email" required class="w-full px-4 py-3 bg-stone-950 border border-stone-800 focus:border-brand-gold rounded-xl text-sm text-white focus:outline-none transition-colors" />
              </div>
              <div class="space-y-2">
                <label for="fTel" class="block text-xs uppercase tracking-wider font-semibold text-stone-300">Teléfono / WhatsApp *</label>
                <input type="tel" id="fTel" name="phone" placeholder="+54 9 2944 ..." autocomplete="tel" required class="w-full px-4 py-3 bg-stone-950 border border-stone-800 focus:border-brand-gold rounded-xl text-sm text-white focus:outline-none transition-colors" />
              </div>
            </div>

            <!-- Row 3: Company & Interest -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="fEmpresa" class="block text-xs uppercase tracking-wider font-semibold text-stone-300">Empresa (opcional)</label>
                <input type="text" id="fEmpresa" name="company" placeholder="Nombre de tu empresa u operadora" autocomplete="organization" class="w-full px-4 py-3 bg-stone-950 border border-stone-800 focus:border-brand-gold rounded-xl text-sm text-white focus:outline-none transition-colors" />
              </div>
              <div class="space-y-2">
                <label for="fInteres" class="block text-xs uppercase tracking-wider font-semibold text-stone-300">Me interesa *</label>
                <select id="fInteres" name="interest" required class="w-full px-4 py-3 bg-stone-950 border border-stone-800 focus:border-brand-gold rounded-xl text-sm text-white focus:outline-none transition-colors">
                  <option value="">Seleccioná una opción</option>
                  <option value="alquiler-corporativo">Alquiler corporativo para empresa</option>
                  <option value="inversion-unidad">Invertir en unidad funcional</option>
                  <option value="inversion-complejo">Invertir en complejo / edificio</option>
                  <option value="alquiler-particular">Alquiler permanente particular</option>
                  <option value="otra">Otra consulta</option>
                </select>
              </div>
            </div>

            <!-- Row 4: Message (AT THE BOTTOM OF INPUTS) -->
            <div class="space-y-2">
              <label for="fMensaje" class="block text-xs uppercase tracking-wider font-semibold text-stone-300">Mensaje (opcional)</label>
              <textarea id="fMensaje" name="message" rows="4" placeholder="Escribí aquí los detalles de tu consulta..." class="w-full px-4 py-3 bg-stone-950 border border-stone-800 focus:border-brand-gold rounded-xl text-sm text-white focus:outline-none transition-colors resize-none"></textarea>
            </div>

            <!-- Row 5: Submit CTA -->
            <Button type="submit" variant="primary" size="lg" class="w-full">
              Enviar Consulta
            </Button>
          </form>
        </div>

      </div>
    </div>
  </section>

</Layout>
