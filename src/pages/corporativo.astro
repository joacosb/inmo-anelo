---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { supabase, PUBLIC_TABLE, statusClass, zoneLabel, getImageUrl, getSrcSet } from '../lib/supabase';
import type { Property } from '../lib/supabase';

// Anchos de optimización: el carrusel de la card (~display 600px) y el modal (~display 660px).
const CARD_W  = 900;
const MODAL_W = 1200;

let complejos: any[] = [];
let edificios: any[] = [];
let dbError: string | null = null;

try {
  const [r1, r2] = await Promise.all([
    supabase.from(PUBLIC_TABLE).select('*').eq('type', 'complejo').eq('for_corporate', true).order('sort_order'),
    supabase.from(PUBLIC_TABLE).select('*').eq('type', 'edificio').eq('for_corporate', true).order('sort_order'),
  ]);
  if (r1.error) throw r1.error;
  if (r2.error) throw r2.error;
  complejos = r1.data ?? [];
  edificios = r2.data ?? [];
} catch (e: any) {
  dbError = e?.message ?? 'Error desconocido';
  console.error('[corporativo] Supabase error:', dbError);
}
---
