---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { supabase, statusClass, zoneLabel } from '../lib/supabase';
import type { Property } from '../lib/supabase';

const { data: complejos = [] } = await supabase
  .from('properties')
  .select('*')
  .eq('type', 'complejo')
  .eq('active', true)
  .order('sort_order');

const { data: edificios = [] } = await supabase
  .from('properties')
  .select('*')
  .eq('type', 'edificio')
  .eq('active', true)
  .order('sort_order');
---
<Layout
  title="Alquiler Corporativo Añelo | Complejos y Edificios Oil & Gas - Inmobiliaria Añelo"
  description="Complejos residenciales y edificios para empresas Oil & Gas en Añelo, Neuquén. Unidades totalmente equipadas con servicios incluidos. Contratos corporativos en USD. Cotizá en 24hs."
  pathname="/corporativo/"
  ogImage="/complejo-yellowstone.webp"
>

  <div class="corporate-hero">
    <div class="section-label reveal">Propiedades Disponibles</div>
    <h2 class="section-title reveal">Nuestros <em>Complejos</em> y Edificios</h2>
    <div class="gold-divider reveal" style="margin:1rem auto 1.5rem;"></div>
    <p class="section-sub reveal">Unidades totalmente equipadas y operativas en Añelo, Neuquén. Contratos flexibles, servicios incluidos, gestión integral.</p>
  </div>
  <div class="amenities-strip">
    <div class="amenity-item"><i data-lucide="zap" class="ai"></i>Electricidad</div>
    <div class="amenity-item"><i data-lucide="droplets" class="ai"></i>Agua</div>
    <div class="amenity-item"><i data-lucide="flame" class="ai"></i>Gas</div>
    <div class="amenity-item"><i data-lucide="tv" class="ai"></i>DirecTV</div>
    <div class="amenity-item"><i data-lucide="wifi" class="ai"></i>Internet</div>
    <div class="amenity-item"><i data-lucide="car" class="ai"></i>Estacionamiento</div>
    <div class="amenity-item"><i data-lucide="utensils" class="ai"></i>Parrilla</div>
  </div>

  <div class="ticker-bar" role="marquee" aria-label="Información de contacto y servicios">
    <div class="ticker-track">
      <span class="ticker-item"><span class="ticker-dot">◆</span>Cotizá tu alquiler en menos de 24 hs</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Soluciones para empresas y particulares</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Alquiler corporativo Oil &amp; Gas — Vaca Muerta</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Invertí en Añelo desde USD 35.000 — 10–12% anual</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Complejos, edificios y UFs totalmente equipados</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>+25 años de trayectoria en la Patagonia</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Contratanos hoy y empezá a generar rentabilidad</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Gestión integral — Vós invertís, nosotros administramos</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Cotizá tu alquiler en menos de 24 hs</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Soluciones para empresas y particulares</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Alquiler corporativo Oil &amp; Gas — Vaca Muerta</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Invertí en Añelo desde USD 35.000 — 10–12% anual</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Complejos, edificios y UFs totalmente equipados</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>+25 años de trayectoria en la Patagonia</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Contratanos hoy y empezá a generar rentabilidad</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Gestión integral — Vós invertís, nosotros administramos</span>
    </div>
  </div>

  <section id="secComplejos">
    <div class="section-label reveal">Complejos de casas</div>
    <div class="section-title reveal">Complejos <em>Residenciales</em></div>
    <div class="gold-divider reveal"></div>
    <p class="section-sub reveal">Complejos cerrados en La Forestada y zonas residenciales de Añelo. Ideales para personal de empresas Oil &amp; Gas.</p>
    <div class="props-grid">
      {(complejos as Property[]).map((p) => (
        <div class="prop-card" data-name={p.name} data-type={p.type} data-section="complejos">
          <img class="prop-img" loading="lazy" decoding="async" src={p.cover_image} alt={p.name} />
          <span class={`prop-status ${statusClass(p.status)}`}>● {p.status_text}</span>
          <div class="prop-body">
            <span class="prop-tag">Complejo</span>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <div class="prop-meta">
              {p.max_guests && <div class="prop-meta-item"><strong>Hasta {p.max_guests}</strong>huéspedes</div>}
              {p.unit_count  && <div class="prop-meta-item"><strong>{p.unit_count}</strong>UFs</div>}
              <div class="prop-meta-item"><strong>{zoneLabel(p.zone, p.type)}</strong></div>
            </div>
            {p.matterport_url && (
              <div class="prop-3d">
                <span class="prop-3d-label">Ver en 3D</span>
                <a href={p.matterport_url} target="_blank" class="btn-3d">▶ Recorrido Virtual</a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="secEdificios" style="background:var(--light); padding-top:4rem; padding-bottom:4rem;">
    <div class="section-label reveal">Edificios de Departamentos</div>
    <div class="section-title reveal">Edificios <em>Pampa</em></div>
    <div class="gold-divider reveal"></div>
    <p class="section-sub reveal">Edificios de varios pisos en el centro de Añelo. Departamentos de 1 y 2 dormitorios, ideal para inversores que buscan diversificar.</p>
    <div class="props-grid">
      {(edificios as Property[]).map((p) => (
        <div class="prop-card" data-name={p.name} data-type={p.type} data-section="edificios">
          <img class="prop-img" loading="lazy" decoding="async" src={p.cover_image} alt={p.name} />
          <span class={`prop-status ${statusClass(p.status)}`}>● {p.status_text}</span>
          <div class="prop-body">
            <span class="prop-tag">Edificio</span>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <div class="prop-meta">
              {p.max_guests && <div class="prop-meta-item"><strong>Hasta {p.max_guests}</strong>huéspedes</div>}
              {p.unit_count  && <div class="prop-meta-item"><strong>{p.unit_count}</strong>UFs</div>}
              <div class="prop-meta-item"><strong>{zoneLabel(p.zone, p.type)}</strong></div>
            </div>
            {p.matterport_url && (
              <div class="prop-3d">
                <span class="prop-3d-label">Ver en 3D</span>
                <a href={p.matterport_url} target="_blank" class="btn-3d">▶ Recorrido Virtual</a>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
    <div style="margin-top:3rem; background:var(--black); border-radius:6px; padding:2.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.5rem;">
      <div>
        <h3 style="font-size:1.3rem; font-weight:700; margin-bottom:.5rem; color:var(--white);">¿Tu empresa necesita alojamiento?</h3>
        <p style="color:rgba(255,255,255,.6); max-width:480px;">Cotizamos en 24hs. Contratos flexibles, duración mínima de 1 mes. Administración integral sin cargo adicional.</p>
      </div>
      <a class="btn-primary" href="/contacto/">Solicitar Cotización</a>
    </div>
  </section>
</Layout>

<script is:inline>
  if (location.hash) {
    setTimeout(function() {
      var el = document.querySelector(location.hash);
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    }, 100);
  }
</script>
