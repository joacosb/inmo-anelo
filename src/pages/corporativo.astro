<!-- DETAIL MODAL -->
<div id="detailModal" class="dm-overlay" onclick="if(event.target===this)closeDM()">
  <div class="dm-inner">
    <button class="dm-close" onclick="closeDM()" aria-label="Cerrar">&times;</button>

    <!-- LEFT: carrusel fijo -->
    <div class="dm-carousel">
      <div class="dm-img-frame">
        <img id="dmImgA" src="" alt="" class="dm-img dm-img-active" />
        <img id="dmImgB" src="" alt="" class="dm-img" />
      </div>
      <button class="dm-car-btn dm-prev" onclick="dmGo(-1)">&#8249;</button>
      <button class="dm-car-btn dm-next" onclick="dmGo(1)">&#8250;</button>
      <div id="dmDots" class="dm-dots"></div>
    </div>

    <!-- RIGHT: info — improved hierarchy -->
    <div class="dm-info">
      <!-- 1. Status badge (above title, no overlap) -->
      <span id="dmStatus" class="prop-status dm-status-badge"></span>

      <!-- 2. Property name -->
      <div class="dm-header">
        <h2 id="dmName"></h2>
      </div>

      <!-- 3. Spec boxes FIRST -->
      <div class="dm-meta">
        <div id="dmGuests" class="dm-meta-item">
          <span class="dm-meta-label">Huéspedes</span>
          <span id="dmGuestsVal" class="dm-meta-val"></span>
        </div>
        <div id="dmUnits" class="dm-meta-item">
          <span class="dm-meta-label">UFs</span>
          <span id="dmUnitsVal" class="dm-meta-val"></span>
        </div>
        <div id="dmZone" class="dm-meta-item">
          <span class="dm-meta-label">Zona</span>
          <span id="dmZoneVal" class="dm-meta-val"></span>
        </div>
      </div>

      <div class="dm-divider"></div>

      <!-- 4. Description BELOW specs -->
      <div class="dm-desc-block">
        <span class="dm-desc-label">Descripción</span>
        <p id="dmDesc"></p>
      </div>

      <!-- 5. Included amenities -->
      <div class="dm-amenities">
        <span class="dm-amenities-label">Incluye sin costo adicional</span>
        <div class="dm-amenities-grid">
          <span class="dm-amenity-item">✓ Todos los servicios</span>
          <span class="dm-amenity-item">✓ WiFi de alta velocidad</span>
          <span class="dm-amenity-item">✓ Equipamiento completo</span>
          <span class="dm-amenity-item">✓ Mantenimiento 24/7</span>
        </div>
      </div>

      <!-- 6. Action buttons -->
      <div class="dm-actions">
        <a id="dmWA" href="#" target="_blank" rel="noopener" class="dm-btn dm-btn-wa"
          onclick="gtag('event','whatsapp_click',{'event_category':'detail_modal'});gtag('event','conversion',{'send_to':'AW-17170667639/kKlFCJvU_JccEPewzvs_','value':1.0,'currency':'ARS'})">
          WhatsApp
        </a>
        <a id="dmMail" href="#" class="dm-btn dm-btn-mail">
          Email
        </a>
        <a id="dmTour" href="#" target="_blank" rel="noopener" class="dm-btn dm-btn-tour">
          Tour 3D
        </a>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* ── DETAIL MODAL ── */
  .dm-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,.82);
    backdrop-filter: blur(8px);
    z-index: 9100;
    display: flex; align-items: center; justify-content: center;
    padding: 1.5rem;
    opacity: 0; pointer-events: none;
    transition: opacity .25s;
  }
  .dm-overlay.open { opacity: 1; pointer-events: all; }

  .dm-inner {
    background: #1c1c1a;
    border: 1px solid rgba(201,168,76,.2);
    border-radius: 16px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 58% 42%;
    width: 100%;
    max-width: 1080px;
    height: min(640px, 90vh);
    position: relative;
    box-shadow: 0 24px 80px rgba(0,0,0,.6);
  }

  /* ── LEFT: carrusel ── */
  .dm-carousel {
    position: relative;
    background: #111;
    overflow: hidden;
  }
  .dm-img-frame {
    position: absolute; inset: 0;
  }
  .dm-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    opacity: 0; transition: opacity .35s ease;
  }
  .dm-img.dm-img-active { opacity: 1; }
  .dm-car-btn {
    position: absolute; top: 50%; transform: translateY(-50%);
    background: rgba(0,0,0,.45); border: none; color: #fff;
    font-size: 2rem; width: 2.4rem; height: 2.4rem;
    border-radius: 50%; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background .15s; z-index: 2;
  }
  .dm-car-btn:hover { background: rgba(0,0,0,.75); }
  .dm-prev { left: .7rem; }
  .dm-next { right: .7rem; }
  .dm-dots {
    position: absolute; bottom: .9rem; left: 50%; transform: translateX(-50%);
    display: flex; gap: .45rem; z-index: 2;
  }
  .dm-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: rgba(255,255,255,.5); cursor: pointer; transition: background .15s;
    border: none;
  }
  .dm-dot.active { background: #c9a84c; }

  /* ── RIGHT: info panel (dark luxury) ── */
  .dm-info {
    padding: 2rem 1.8rem 1.6rem;
    overflow-y: auto;
    display: flex; flex-direction: column; gap: .85rem;
    font-family: 'Montserrat', sans-serif;
    color: #eee;
    background: #1c1c1a;
  }

  /* Status badge — sits above title, styled as small pill */
  .dm-status-badge {
    position: static !important;
    display: inline-block;
    width: fit-content;
    font-size: .7rem !important;
    padding: .25rem .75rem !important;
    border-radius: 20px;
    letter-spacing: .08em;
  }

  .dm-header { display: flex; flex-direction: column; gap: .25rem; }
  .dm-info h2 {
    font-family: var(--font-display);
    font-size: 1.6rem; font-weight: 600; margin: 0; line-height: 1.15;
    color: #fff;
  }

  .dm-divider {
    border: none; border-top: 1px solid rgba(255,255,255,.1); margin: .15rem 0;
  }

  /* Spec boxes */
  .dm-meta {
    display: flex; flex-wrap: wrap; gap: .6rem;
  }
  .dm-meta-item {
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1);
    border-radius: 10px;
    padding: .6rem .9rem; font-size: .8rem;
    display: flex; flex-direction: column; gap: .15rem;
    min-width: 80px; flex: 1;
  }
  .dm-meta-label {
    color: rgba(255,255,255,.5); font-size: .66rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: .06em;
  }
  .dm-meta-val { color: #fff; font-weight: 700; font-size: .95rem; }

  /* Description block */
  .dm-desc-block {
    display: flex; flex-direction: column; gap: .35rem;
  }
  .dm-desc-label {
    font-size: .66rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .1em; color: #c9a84c;
  }
  .dm-info p {
    font-size: .84rem; color: rgba(255,255,255,.65); line-height: 1.65; margin: 0;
  }

  /* Amenities grid */
  .dm-amenities {
    border-top: 1px solid rgba(255,255,255,.08);
    padding-top: .6rem;
    display: flex; flex-direction: column; gap: .45rem;
  }
  .dm-amenities-label {
    font-size: .64rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .08em; color: rgba(255,255,255,.4);
  }
  .dm-amenities-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: .3rem .8rem;
  }
  .dm-amenity-item {
    font-size: .75rem; color: rgba(255,255,255,.6); font-weight: 500;
  }

  /* Action buttons */
  .dm-actions {
    display: flex; flex-direction: row; gap: .4rem; margin-top: auto; flex-wrap: nowrap;
  }
  .dm-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .3rem;
    flex: 1; text-align: center; border-radius: 8px;
    padding: .5rem .5rem; font-size: .7rem; font-weight: 700; letter-spacing: .05em;
    text-transform: uppercase; white-space: nowrap;
    font-family: 'Montserrat', sans-serif;
    text-decoration: none; transition: background .15s, filter .15s;
    cursor: pointer; border: none;
  }
  .dm-btn-wa   { background: #25d366; color: #fff; }
  .dm-btn-wa:hover { filter: brightness(.9); }
  .dm-btn-mail { background: transparent; color: #ddd; border: 1.5px solid rgba(255,255,255,.2); }
  .dm-btn-mail:hover { background: rgba(255,255,255,.1); color: #fff; }
  .dm-btn-tour { background: transparent; color: #c9a84c; border: 1.5px solid rgba(201,168,76,.4); }
  .dm-btn-tour:hover { background: rgba(201,168,76,.12); }

  /* ── CLOSE ── */
  .dm-close {
    position: absolute; top: .8rem; right: .8rem; z-index: 10;
    background: rgba(0,0,0,.5); border: none; color: #fff;
    font-size: 1.3rem; width: 2rem; height: 2rem; border-radius: 50%;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: background .15s;
  }
  .dm-close:hover { background: rgba(0,0,0,.85); }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    .dm-overlay { padding: 0; align-items: flex-end; }
    .dm-inner {
      grid-template-columns: 1fr;
      grid-template-rows: 50vh 1fr;
      height: 92vh;
      border-radius: 16px 16px 0 0;
      max-width: 100%;
    }
    .dm-carousel { min-height: 50vh; }
    .dm-info { padding: 1.25rem 1.1rem 1.5rem; overflow-y: auto; }
    .dm-info h2 { font-size: 1.2rem; }
  }

  /* ── FILTER BAR ── */
  .filter-bar {
    display: flex; align-items: center; justify-content: flex-end;
    padding: .75rem 8%;
    background: var(--white);
    border-bottom: 1px solid var(--border);
  }
  .filter-toggle {
    display: inline-flex; align-items: center; gap: .75rem;
    cursor: pointer; user-select: none;
  }
  .filter-toggle input { display: none; }
  .filter-toggle-track {
    position: relative; width: 40px; height: 22px;
    background: #ccc; border-radius: 11px;
    transition: background .2s;
    flex-shrink: 0;
  }
  .filter-toggle input:checked + .filter-toggle-track { background: var(--gold); }
  .filter-toggle-thumb {
    position: absolute; top: 3px; left: 3px;
    width: 16px; height: 16px; border-radius: 50%;
    background: #fff; transition: transform .2s;
    box-shadow: 0 1px 3px rgba(0,0,0,.2);
  }
  .filter-toggle input:checked + .filter-toggle-track .filter-toggle-thumb { transform: translateX(18px); }
  .filter-toggle-label {
    font-size: .78rem; font-weight: 600; letter-spacing: .06em;
    text-transform: uppercase; color: var(--gray);
    transition: color .2s;
  }
  .filter-toggle input:checked ~ .filter-toggle-label { color: var(--black); }
  .prop-card.filtered-out { display: none; }
</style>

<script is:inline>
  if (location.hash) {
    setTimeout(function() {
      var el = document.querySelector(location.hash);
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    }, 100);
  }

  // ── CARRUSEL DE CARD ──────────────────────────────────────
  document.querySelectorAll('.prop-img-wrap[data-images]').forEach(function(wrap) {
    var imgs = JSON.parse(wrap.dataset.images);
    if (imgs.length <= 1) return;
    var positions = JSON.parse(wrap.dataset.positions || '[]');
    var idx = 0;
    var dots = wrap.querySelectorAll('.car-dot');

    // Cross-fade: dos capas superpuestas
    var imgA = wrap.querySelector('.prop-img');
    var layerStyle = 'position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;object-fit:cover;display:block;transition:opacity .35s ease;';
    var initPos = imgA.style.objectPosition || '50% 50%';
    imgA.style.cssText = layerStyle + 'opacity:1;object-position:' + initPos;
    var imgB = document.createElement('img');
    imgB.className = 'prop-img';
    imgB.alt = imgA.alt;
    imgB.decoding = 'async';
    imgB.style.cssText = layerStyle + 'opacity:0;object-position:' + initPos;
    imgA.after(imgB);
    var activeImg = imgA, inactiveImg = imgB;

    var preloaded = {};
    preloaded[0] = true;
    function preloadImg(i) { if (preloaded[i]) return; preloaded[i] = true; (new Image()).src = imgs[i]; }
    function preloadWindow(c) { preloadImg((c+1)%imgs.length); preloadImg((c-1+imgs.length)%imgs.length); }
    preloadWindow(0);

    function go(n) {
      idx = (idx + n + imgs.length) % imgs.length;
      var next = imgs[idx], nextPos = positions[idx] || '50% 50%', targetIdx = idx;
      var cur = { a: activeImg, b: inactiveImg };
      function swap() {
        cur.b.style.objectPosition = nextPos;
        cur.b.style.opacity = '1';
        cur.a.style.opacity = '0';
        activeImg = cur.b; inactiveImg = cur.a;
        dots.forEach(function(d, i) { d.classList.toggle('active', i === targetIdx); });
        preloadWindow(targetIdx);
      }
      cur.b.src = next;
      var tmp = new Image();
      tmp.onload = swap; tmp.src = next;
      if (tmp.complete) swap();
    }

    wrap.querySelector('.car-prev').addEventListener('click', function(e) { e.stopPropagation(); go(-1); });
    wrap.querySelector('.car-next').addEventListener('click', function(e) { e.stopPropagation(); go(1); });

    var touchStartX = 0;
    wrap.addEventListener('touchstart', function(e) { touchStartX = e.touches[0].clientX; }, { passive: true });
    wrap.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) { e.stopPropagation(); go(dx > 0 ? -1 : 1); }
    });
  });

  // ── DETAIL MODAL ─────────────────────────────────────────
  var dmImgs = [];
  var dmIdx  = 0;
  var dmLastCard = null;
  var dmActiveLayer = 'A';

  function dmPreload(imgs) {
    imgs.forEach(function(src) { (new Image()).src = src; });
  }

  function openDM(card) {
    dmLastCard = card;
    dmImgs = JSON.parse(card.dataset.images || '[]');
    dmIdx  = 0;
    dmPreload(dmImgs);

    dmActiveLayer = 'A';
    var imgA = document.getElementById('dmImgA');
    var imgB = document.getElementById('dmImgB');
    imgA.src = dmImgs[0] || '';
    imgA.className = 'dm-img dm-img-active';
    imgB.className = 'dm-img';
    imgB.src = '';

    // dots
    var dotsEl = document.getElementById('dmDots');
    dotsEl.innerHTML = '';
    if (dmImgs.length > 1) {
      dmImgs.forEach(function(_, i) {
        var d = document.createElement('span');
        d.className = 'dm-dot' + (i === 0 ? ' active' : '');
        d.addEventListener('click', function() { dmJump(i); });
        dotsEl.appendChild(d);
      });
    }
    document.querySelector('.dm-prev').style.display = dmImgs.length > 1 ? '' : 'none';
    document.querySelector('.dm-next').style.display = dmImgs.length > 1 ? '' : 'none';
    dmSwipeInit();

    // info
    document.getElementById('dmName').textContent = card.dataset.name || '';
    document.getElementById('dmDesc').textContent = card.dataset.desc || '';

    var statusEl = document.getElementById('dmStatus');
    statusEl.textContent = '● ' + (card.dataset.status || '');
    statusEl.className = 'prop-status dm-status-badge ' + (card.dataset.statusClass || '');

    var gEl = document.getElementById('dmGuests');
    gEl.style.display = card.dataset.guests ? '' : 'none';
    document.getElementById('dmGuestsVal').textContent = 'Hasta ' + card.dataset.guests;

    var uEl = document.getElementById('dmUnits');
    uEl.style.display = card.dataset.units ? '' : 'none';
    document.getElementById('dmUnitsVal').textContent = card.dataset.units;

    var zEl = document.getElementById('dmZone');
    zEl.style.display = card.dataset.zone ? '' : 'none';
    document.getElementById('dmZoneVal').textContent = card.dataset.zone;

    var name = card.dataset.name || '';
    var waMsg = encodeURIComponent('Hola! Me interesa ' + name + '. Actualmente busco alquiler para...');
    document.getElementById('dmWA').href = 'https://wa.me/5492944486303?text=' + waMsg;

    var section = card.dataset.section || '';
    var mailSubject = encodeURIComponent('Alquiler corporativo' + (name ? ' — ' + name : ''));
    var mailBody = encodeURIComponent('Hola, estuve en su sitio web y me interesa ' + (section === 'edificios' ? 'el edificio ' : 'el complejo ') + name + '. ¿Podrían enviarme más información?');
    document.getElementById('dmMail').href = 'mailto:grupopampanqn@gmail.com?subject=' + mailSubject + '&body=' + mailBody;

    var tourEl = document.getElementById('dmTour');
    var fallbackTour = card.dataset.type === 'edificio' ? 'https://my.matterport.com/show/?m=HdzbizKQMrt' : 'https://my.matterport.com/show/?m=z9F3K5h3gok';
    tourEl.href = card.dataset.matterport || fallbackTour;

    document.getElementById('detailModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  var dmTouchStartX = 0;
  var dmSwipeAttached = false;
  function dmSwipeInit() {
    if (dmSwipeAttached) return;
    dmSwipeAttached = true;
    var carousel = document.querySelector('.dm-carousel');
    carousel.addEventListener('touchstart', function(e) {
      dmTouchStartX = e.touches[0].clientX;
    }, { passive: true });
    carousel.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].clientX - dmTouchStartX;
      if (Math.abs(dx) > 40 && dmImgs.length > 1) dmGo(dx > 0 ? -1 : 1);
    }, { passive: true });
  }

  function closeDM() {
    document.getElementById('detailModal').classList.remove('open');
    document.body.style.overflow = '';
    if (dmLastCard) {
      dmLastCard.setAttribute('tabindex', '-1');
      dmLastCard.focus({ preventScroll: true });
      dmLastCard = null;
    }
  }

  function dmGo(n) {
    dmIdx = (dmIdx + n + dmImgs.length) % dmImgs.length;
    dmUpdate();
  }
  function dmJump(i) { dmIdx = i; dmUpdate(); }

  function dmUpdate() {
    var next = dmImgs[dmIdx];
    var nextLayer = dmActiveLayer === 'A' ? 'B' : 'A';
    var activeEl  = document.getElementById('dmImg' + dmActiveLayer);
    var inactiveEl = document.getElementById('dmImg' + nextLayer);

    function swap() {
      inactiveEl.classList.add('dm-img-active');
      activeEl.classList.remove('dm-img-active');
      dmActiveLayer = nextLayer;
    }

    inactiveEl.src = next;
    var tmp = new Image();
    tmp.onload = swap;
    tmp.src = next;
    if (tmp.complete) swap();

    document.querySelectorAll('.dm-dot').forEach(function(d, i) {
      d.classList.toggle('active', i === dmIdx);
    });
  }

  document.querySelectorAll('.prop-card--detail').forEach(function(card) {
    card.addEventListener('click', function(e) {
      if (e.target.closest('a, button')) return;
      openDM(card);
    });
  });

  document.addEventListener('keydown', function(e) {
    if (!document.getElementById('detailModal').classList.contains('open')) return;
    if (e.key === 'Escape') closeDM();
    if (e.key === 'ArrowLeft')  dmGo(-1);
    if (e.key === 'ArrowRight') dmGo(1);
  });

  // ── FILTRO DISPONIBLES ────────────────────────────────────
  document.getElementById('filterDisponibles').addEventListener('change', function() {
    var onlyAvail = this.checked;
    document.querySelectorAll('.prop-card--detail').forEach(function(card) {
      var isOccupied = card.dataset.statusClass === 'ocupado';
      card.classList.toggle('filtered-out', onlyAvail && isOccupied);
    });
  });
</script>
