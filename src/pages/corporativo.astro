---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { supabase, statusClass, zoneLabel } from '../lib/supabase';
import type { Property } from '../lib/supabase';

let complejos: any[] = [];
let edificios: any[] = [];
let dbError: string | null = null;

try {
  const [r1, r2] = await Promise.all([
    supabase.from('properties').select('*').eq('type', 'complejo').eq('active', true).order('sort_order'),
    supabase.from('properties').select('*').eq('type', 'edificio').eq('active', true).order('sort_order'),
  ]);
  if (r1.error) throw r1.error;
  if (r2.error) throw r2.error;
  complejos = r1.data ?? [];
  edificios = r2.data ?? [];
} catch (e: any) {
  dbError = e?.message ?? 'Error desconocido';
  console.error('[corporativo] Supabase error:', dbError);
}
---
<Layout
  title="Alquiler Corporativo Añelo | Complejos y Edificios Oil & Gas - Inmobiliaria Añelo"
  description="Complejos residenciales y edificios para empresas Oil & Gas en Añelo, Neuquén. Unidades totalmente equipadas con servicios incluidos. Contratos corporativos en USD. Cotizá en 24hs."
  pathname="/corporativo/"
  ogImage="/complejo-yellowstone.webp"
>

  {dbError && (
    <div style="background:#c0392b;color:#fff;padding:1rem 2rem;font-family:monospace;font-size:.85rem;word-break:break-all;">
      <strong>DB ERROR:</strong> {dbError} &nbsp;|&nbsp;
      URL: {import.meta.env.PUBLIC_SUPABASE_URL ?? '(no definida)'}
    </div>
  )}

  <div class="corporate-hero">
    <div class="section-label reveal">Propiedades Disponibles</div>
    <h2 class="section-title reveal">Nuestros <em>Complejos</em> y Edificios</h2>
    <div class="gold-divider reveal" style="margin:1rem auto 1.5rem;"></div>
    <p class="section-sub reveal">Unidades totalmente equipadas y operativas en Añelo, Neuquén. Contratos flexibles, servicios incluidos, gestión integral.</p>
  </div>
  <div class="amenities-strip">
    <div class="amenity-item"><i data-lucide="zap" class="ai"></i>Electricidad</div>
    <div class="amenity-item"><i data-lucide="droplets" class="ai"></i>Agua</div>
    <div class="amenity-item"><i data-lucide="flame" class="ai"></i>Gas</div>
    <div class="amenity-item"><i data-lucide="tv" class="ai"></i>DirecTV</div>
    <div class="amenity-item"><i data-lucide="wifi" class="ai"></i>Internet</div>
    <div class="amenity-item"><i data-lucide="car" class="ai"></i>Estacionamiento</div>
    <div class="amenity-item"><i data-lucide="utensils" class="ai"></i>Parrilla</div>
  </div>

  <div class="ticker-bar" role="marquee" aria-label="Información de contacto y servicios">
    <div class="ticker-track">
      <span class="ticker-item"><span class="ticker-dot">◆</span>Cotizá tu alquiler en menos de 24 hs</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Soluciones para empresas y particulares</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Alquiler corporativo Oil &amp; Gas — Vaca Muerta</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Invertí en Añelo desde USD 35.000 — 10–12% anual</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Complejos, edificios y UFs totalmente equipados</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>+25 años de trayectoria en la Patagonia</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Contratanos hoy y empezá a generar rentabilidad</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Gestión integral — Vós invertís, nosotros administramos</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Cotizá tu alquiler en menos de 24 hs</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Soluciones para empresas y particulares</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Alquiler corporativo Oil &amp; Gas — Vaca Muerta</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Invertí en Añelo desde USD 35.000 — 10–12% anual</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Complejos, edificios y UFs totalmente equipados</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>+25 años de trayectoria en la Patagonia</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Contratanos hoy y empezá a generar rentabilidad</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Gestión integral — Vós invertís, nosotros administramos</span>
    </div>
  </div>

  <section id="secComplejos">
    <div class="section-label reveal">Complejos de casas</div>
    <div class="section-title reveal">Complejos <em>Residenciales</em></div>
    <div class="gold-divider reveal"></div>
    <p class="section-sub reveal">Complejos cerrados en La Forestada y zonas residenciales de Añelo. Ideales para personal de empresas Oil &amp; Gas.</p>
    <div class="props-grid">
      {(complejos as Property[]).map((p) => (
        <div
          class="prop-card prop-card--detail"
          data-name={p.name}
          data-type={p.type}
          data-section="complejos"
          data-no-modal="1"
          data-images={JSON.stringify(p.images?.length > 0 ? p.images : (p.cover_image ? [p.cover_image] : []))}
          data-desc={p.description ?? ''}
          data-guests={p.max_guests ?? ''}
          data-units={p.unit_count ?? ''}
          data-zone={zoneLabel(p.zone, p.type)}
          data-matterport={p.matterport_url ?? ''}
          data-status={p.status_text ?? ''}
          data-status-class={statusClass(p.status)}
        >
          <div class="prop-img-wrap" data-images={JSON.stringify(p.images?.length > 1 ? p.images : [p.cover_image])}>
            <img class="prop-img" loading="lazy" decoding="async" src={p.cover_image} alt={p.name} />
            {p.images?.length > 1 && (
              <>
                <button class="car-btn car-prev" aria-label="Anterior">&#8249;</button>
                <button class="car-btn car-next" aria-label="Siguiente">&#8250;</button>
                <div class="car-dots">{p.images.map((_: string, i: number) => <span class={`car-dot${i === 0 ? ' active' : ''}`}></span>)}</div>
              </>
            )}
          </div>
          <span class={`prop-status ${statusClass(p.status)}`}>● {p.status_text}</span>
          <div class="prop-body">
            <span class="prop-tag">Complejo</span>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <div class="prop-meta">
              {p.max_guests && <div class="prop-meta-item"><strong>Hasta {p.max_guests}</strong>huéspedes</div>}
              {p.unit_count  && <div class="prop-meta-item"><strong>{p.unit_count}</strong>UFs</div>}
              <div class="prop-meta-item"><strong>{zoneLabel(p.zone, p.type)}</strong></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="secEdificios" style="background:var(--light); padding-top:4rem; padding-bottom:4rem;">
    <div class="section-label reveal">Edificios de Departamentos</div>
    <div class="section-title reveal">Edificios <em>Pampa</em></div>
    <div class="gold-divider reveal"></div>
    <p class="section-sub reveal">Edificios de varios pisos en el centro de Añelo. Departamentos de 1 y 2 dormitorios, ideal para inversores que buscan diversificar.</p>
    <div class="props-grid">
      {(edificios as Property[]).map((p) => (
        <div
          class="prop-card prop-card--detail"
          data-name={p.name}
          data-type={p.type}
          data-section="edificios"
          data-no-modal="1"
          data-images={JSON.stringify(p.images?.length > 0 ? p.images : (p.cover_image ? [p.cover_image] : []))}
          data-desc={p.description ?? ''}
          data-guests={p.max_guests ?? ''}
          data-units={p.unit_count ?? ''}
          data-zone={zoneLabel(p.zone, p.type)}
          data-matterport={p.matterport_url ?? ''}
          data-status={p.status_text ?? ''}
          data-status-class={statusClass(p.status)}
        >
          <div class="prop-img-wrap" data-images={JSON.stringify(p.images?.length > 1 ? p.images : [p.cover_image])}>
            <img class="prop-img" loading="lazy" decoding="async" src={p.cover_image} alt={p.name} />
            {p.images?.length > 1 && (
              <>
                <button class="car-btn car-prev" aria-label="Anterior">&#8249;</button>
                <button class="car-btn car-next" aria-label="Siguiente">&#8250;</button>
                <div class="car-dots">{p.images.map((_: string, i: number) => <span class={`car-dot${i === 0 ? ' active' : ''}`}></span>)}</div>
              </>
            )}
          </div>
          <span class={`prop-status ${statusClass(p.status)}`}>● {p.status_text}</span>
          <div class="prop-body">
            <span class="prop-tag">Edificio</span>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <div class="prop-meta">
              {p.max_guests && <div class="prop-meta-item"><strong>Hasta {p.max_guests}</strong>huéspedes</div>}
              {p.unit_count  && <div class="prop-meta-item"><strong>{p.unit_count}</strong>UFs</div>}
              <div class="prop-meta-item"><strong>{zoneLabel(p.zone, p.type)}</strong></div>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div style="margin-top:3rem; background:var(--black); border-radius:6px; padding:2.5rem; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.5rem;">
      <div>
        <h3 style="font-size:1.3rem; font-weight:700; margin-bottom:.5rem; color:var(--white);">¿Tu empresa necesita alojamiento?</h3>
        <p style="color:rgba(255,255,255,.6); max-width:480px;">Cotizamos en 24hs. Contratos flexibles, duración mínima de 1 mes. Administración integral sin cargo adicional.</p>
      </div>
      <a class="btn-primary" href="/contacto/">Solicitar Cotización</a>
    </div>
  </section>
</Layout>

<!-- DETAIL MODAL -->
<div id="detailModal" class="dm-overlay" onclick="if(event.target===this)closeDM()">
  <div class="dm-inner">
    <button class="dm-close" onclick="closeDM()" aria-label="Cerrar">&times;</button>
    <div class="dm-carousel">
      <img id="dmImg" src="" alt="" />
      <button class="dm-car-btn dm-prev" onclick="dmGo(-1)">&#8249;</button>
      <button class="dm-car-btn dm-next" onclick="dmGo(1)">&#8250;</button>
      <div id="dmDots" class="dm-dots"></div>
    </div>
    <div class="dm-info">
      <span id="dmStatus" class="prop-status"></span>
      <h2 id="dmName"></h2>
      <p id="dmDesc"></p>
      <div class="dm-meta">
        <div id="dmGuests" class="dm-meta-item"></div>
        <div id="dmUnits"  class="dm-meta-item"></div>
        <div id="dmZone"   class="dm-meta-item"></div>
      </div>
      <div class="dm-actions">
        <a id="dmWA" href="#" target="_blank" rel="noopener" class="dm-btn dm-btn-wa"
          onclick="gtag('event','whatsapp_click',{'event_category':'detail_modal'});gtag('event','conversion',{'send_to':'AW-17170667639/kKlFCJvU_JccEPewzvs_','value':1.0,'currency':'ARS'})">
          💬 Consultar por WhatsApp
        </a>
        <a id="dmTour" href="#" target="_blank" rel="noopener" class="dm-btn dm-btn-tour"
          onclick="gtag('event','virtual_tour',{'event_category':'detail_modal'})">
          ▶ Recorrido Virtual
        </a>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* ── DETAIL MODAL ── */
  .dm-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,.88);
    z-index: 9100;
    display: flex; align-items: center; justify-content: center;
    padding: 1rem;
    opacity: 0; pointer-events: none;
    transition: opacity .25s;
  }
  .dm-overlay.open { opacity: 1; pointer-events: all; }

  .dm-inner {
    background: #111;
    border-radius: 14px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    max-width: 920px;
    max-height: 88vh;
    position: relative;
  }

  /* ── LEFT: carousel ── */
  .dm-carousel {
    position: relative;
    background: #000;
    min-height: 320px;
  }
  .dm-carousel img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity .15s;
  }
  .dm-car-btn {
    position: absolute; top: 50%; transform: translateY(-50%);
    background: rgba(0,0,0,.55); border: none; color: #fff;
    font-size: 2rem; line-height: 1; width: 2.4rem; height: 2.4rem;
    border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: background .15s;
  }
  .dm-car-btn:hover { background: rgba(0,0,0,.8); }
  .dm-prev { left: .6rem; }
  .dm-next { right: .6rem; }
  .dm-dots {
    position: absolute; bottom: .75rem; left: 50%; transform: translateX(-50%);
    display: flex; gap: .4rem;
  }
  .dm-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: rgba(255,255,255,.45); cursor: pointer; transition: background .15s;
  }
  .dm-dot.active { background: #c9a84c; }

  /* ── RIGHT: info ── */
  .dm-info {
    padding: 2rem 1.75rem 1.75rem;
    overflow-y: auto;
    display: flex; flex-direction: column; gap: 1rem;
    font-family: 'Montserrat', sans-serif;
    color: #fff;
  }
  .dm-info h2 {
    font-size: 1.5rem; font-weight: 700; margin: 0; line-height: 1.2;
  }
  .dm-info p {
    font-size: .88rem; color: rgba(255,255,255,.65); line-height: 1.6; margin: 0;
  }
  .dm-meta {
    display: flex; flex-wrap: wrap; gap: .6rem;
  }
  .dm-meta-item {
    background: rgba(255,255,255,.07); border-radius: 6px;
    padding: .45rem .8rem; font-size: .8rem;
    display: flex; flex-direction: column; gap: .1rem;
  }
  .dm-meta-item strong { font-size: .95rem; color: #c9a84c; }
  .dm-actions {
    display: flex; flex-direction: column; gap: .65rem; margin-top: auto;
  }
  .dm-btn {
    display: block; text-align: center; border-radius: 7px;
    padding: .75rem 1rem; font-size: .85rem; font-weight: 700;
    font-family: 'Montserrat', sans-serif;
    text-decoration: none; transition: background .15s, opacity .15s;
    cursor: pointer;
  }
  .dm-btn-wa  { background: #25d366; color: #000; }
  .dm-btn-wa:hover { background: #1db954; }
  .dm-btn-tour { background: rgba(201,168,76,.18); color: #c9a84c; border: 1px solid rgba(201,168,76,.4); }
  .dm-btn-tour:hover { background: rgba(201,168,76,.28); }

  /* ── CLOSE ── */
  .dm-close {
    position: absolute; top: .75rem; right: .75rem; z-index: 10;
    background: rgba(0,0,0,.6); border: none; color: #fff;
    font-size: 1.4rem; width: 2rem; height: 2rem; border-radius: 50%;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    line-height: 1; transition: background .15s;
  }
  .dm-close:hover { background: rgba(0,0,0,.9); }

  /* ── MOBILE ── */
  @media (max-width: 640px) {
    .dm-inner {
      grid-template-columns: 1fr;
      grid-template-rows: 52vw 1fr;
      max-height: 92vh;
    }
    .dm-info { padding: 1.25rem 1rem 1rem; }
    .dm-info h2 { font-size: 1.2rem; }
  }
</style>

<script is:inline>
  if (location.hash) {
    setTimeout(function() {
      var el = document.querySelector(location.hash);
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    }, 100);
  }

  // ── CARRUSEL DE CARD ──────────────────────────────────────
  document.querySelectorAll('.prop-img-wrap[data-images]').forEach(function(wrap) {
    var imgs = JSON.parse(wrap.dataset.images);
    if (imgs.length <= 1) return;
    var idx  = 0;
    var img  = wrap.querySelector('.prop-img');
    var dots = wrap.querySelectorAll('.car-dot');
    function go(n) {
      idx = (idx + n + imgs.length) % imgs.length;
      img.style.opacity = '0';
      setTimeout(function() { img.src = imgs[idx]; img.style.opacity = '1'; }, 150);
      dots.forEach(function(d, i) { d.classList.toggle('active', i === idx); });
    }
    wrap.querySelector('.car-prev').addEventListener('click', function(e) { e.stopPropagation(); go(-1); });
    wrap.querySelector('.car-next').addEventListener('click', function(e) { e.stopPropagation(); go(1); });
  });

  // ── DETAIL MODAL ─────────────────────────────────────────
  var dmImgs = [];
  var dmIdx  = 0;

  function openDM(card) {
    dmImgs = JSON.parse(card.dataset.images || '[]');
    dmIdx  = 0;

    var imgEl = document.getElementById('dmImg');
    imgEl.src = dmImgs[0] || '';

    // dots
    var dotsEl = document.getElementById('dmDots');
    dotsEl.innerHTML = '';
    if (dmImgs.length > 1) {
      dmImgs.forEach(function(_, i) {
        var d = document.createElement('span');
        d.className = 'dm-dot' + (i === 0 ? ' active' : '');
        d.addEventListener('click', function() { dmJump(i); });
        dotsEl.appendChild(d);
      });
    }

    // show/hide arrows
    document.querySelector('.dm-prev').style.display = dmImgs.length > 1 ? '' : 'none';
    document.querySelector('.dm-next').style.display = dmImgs.length > 1 ? '' : 'none';

    // info
    document.getElementById('dmName').textContent = card.dataset.name || '';
    document.getElementById('dmDesc').textContent = card.dataset.desc || '';

    var statusEl = document.getElementById('dmStatus');
    statusEl.textContent = '● ' + (card.dataset.status || '');
    statusEl.className = 'prop-status ' + (card.dataset.statusClass || '');

    var gEl = document.getElementById('dmGuests');
    if (card.dataset.guests) {
      gEl.style.display = '';
      gEl.innerHTML = '<strong>Hasta ' + card.dataset.guests + '</strong>huéspedes';
    } else { gEl.style.display = 'none'; }

    var uEl = document.getElementById('dmUnits');
    if (card.dataset.units) {
      uEl.style.display = '';
      uEl.innerHTML = '<strong>' + card.dataset.units + '</strong>UFs';
    } else { uEl.style.display = 'none'; }

    var zEl = document.getElementById('dmZone');
    if (card.dataset.zone) {
      zEl.style.display = '';
      zEl.innerHTML = '<strong>' + card.dataset.zone + '</strong>';
    } else { zEl.style.display = 'none'; }

    var waMsg = encodeURIComponent('Hola! Me interesa ' + (card.dataset.name || '') + '. Actualmente busco alquiler para...');
    document.getElementById('dmWA').href = 'https://wa.me/5492972431619?text=' + waMsg;

    var tourEl = document.getElementById('dmTour');
    if (card.dataset.matterport) {
      tourEl.style.display = '';
      tourEl.href = card.dataset.matterport;
    } else { tourEl.style.display = 'none'; }

    document.getElementById('detailModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDM() {
    document.getElementById('detailModal').classList.remove('open');
    document.body.style.overflow = '';
  }

  function dmGo(n) {
    dmIdx = (dmIdx + n + dmImgs.length) % dmImgs.length;
    dmUpdate();
  }

  function dmJump(i) {
    dmIdx = i;
    dmUpdate();
  }

  function dmUpdate() {
    var img = document.getElementById('dmImg');
    img.style.opacity = '0';
    setTimeout(function() { img.src = dmImgs[dmIdx]; img.style.opacity = '1'; }, 150);
    document.querySelectorAll('.dm-dot').forEach(function(d, i) {
      d.classList.toggle('active', i === dmIdx);
    });
  }

  document.querySelectorAll('.prop-card--detail').forEach(function(card) {
    card.addEventListener('click', function(e) {
      if (e.target.closest('a, button')) return;
      openDM(card);
    });
  });

  document.addEventListener('keydown', function(e) {
    if (!document.getElementById('detailModal').classList.contains('open')) return;
    if (e.key === 'Escape') closeDM();
    if (e.key === 'ArrowLeft')  dmGo(-1);
    if (e.key === 'ArrowRight') dmGo(1);
  });
</script>
