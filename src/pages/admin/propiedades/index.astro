---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createClient } from '@supabase/supabase-js';
import AdminPropertyCard from '../../../components/AdminPropertyCard.astro';
import { SUPABASE_URL, SUPABASE_ANON } from '../../../lib/supabase';


const token = Astro.cookies.get('sb_token')!.value;

const sb = createClient(SUPABASE_URL, SUPABASE_ANON, {
  global: { headers: { Authorization: `Bearer ${token}` } },
});

// Sin filtro por `active`: el panel muestra también las ocultas, que son las
// que el usuario sacó del sitio público pero quiere conservar. La vista
// `properties_public` ya filtra `where active`, así que el sitio no las ve.
const { data: properties = [] } = await sb
  .from('properties')
  .select('*')
  .order('sort_order');

const all = properties ?? [];

const visiblesCount = all.filter((p: any) => p.active === true).length;
const ocultasCount  = all.length - visiblesCount;

// El agrupado sigue el criterio corporativo (complejo / edificio), pero una
// propiedad publicada sólo en venta o alquiler no entra en ninguno de los dos:
// va al grupo de abajo para que nunca quede fuera del listado.
const complejos = all.filter((p: any) => p.for_corporate && p.type === 'complejo');
const edificios = all.filter((p: any) => p.for_corporate && p.type === 'edificio');
const otras     = all.filter((p: any) => !complejos.includes(p) && !edificios.includes(p));
---
<AdminLayout title="Propiedades" section="propiedades">
  {/* is:global porque el markup de las cards vive en AdminPropertyCard.astro
      y los estilos scoped no cruzan el límite del componente. */}
  <style is:global>
    /* MAIN */
    .adm-main { max-width: 1240px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
    .adm-section-title {
      font-size: .72rem;
      font-weight: 700;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: #c9a84c;
      margin-bottom: 1.25rem;
      padding-bottom: .6rem;
      border-bottom: 1px solid rgba(201,168,76,.25);
    }

    /* SECCIONES
       El gap del flex ignora los hijos con display:none, así que al filtrar
       nunca queda un hueco arriba ni doble separación entre grupos. */
    .adm-sections { display: flex; flex-direction: column; gap: 3rem; }
    .adm-section[hidden], .adm-card[hidden] { display: none; }

    /* GRID */
    .adm-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.75rem;
    }

    /* CARD */
    .adm-card {
      background: #23231F;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 16px;
      overflow: hidden;
      transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
      box-shadow: 0 4px 20px rgba(0,0,0,.4);
    }
    .adm-card:hover { border-color: rgba(201,168,76,.5); transform: translateY(-3px); box-shadow: 0 10px 30px rgba(201,168,76,.12); }

    /* CARD OCULTA
       El texto queda a contraste pleno (es info que hay que poder leer);
       lo que marca el estado es la foto apagada, el borde punteado y el badge. */
    .adm-card.is-hidden { background: #1D1D1A; border-style: dashed; border-color: rgba(255,255,255,.18); }
    .adm-card.is-hidden .adm-card-img { filter: grayscale(.95); opacity: .45; }
    .adm-card-media { position: relative; }
    .adm-vis-badge {
      position: absolute; top: .6rem; left: .6rem;
      display: none;
      background: rgba(0,0,0,.85); color: #ffffff;
      border: 1px solid rgba(255,255,255,.35);
      font-size: .6rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      padding: .25rem .55rem; border-radius: 6px;
    }
    .adm-card.is-hidden .adm-vis-badge { display: block; }

    .adm-card-img {
      width: 100%;
      height: 170px;
      object-fit: cover;
      display: block;
    }
    .adm-card-noimg {
      display: flex; align-items: center; justify-content: center;
      background: #141412; color: rgba(255,255,255,.3); font-size: .8rem; font-weight: 500;
    }
    .adm-card-body { padding: 1.25rem 1.35rem; }
    .adm-card-name { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: #ffffff; margin-bottom: .7rem; }

    /* TOOLBAR */
    .adm-toolbar {
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;
    }

    /* FILTRO DE VISIBILIDAD */
    .vis-filter {
      display: inline-flex; gap: .25rem; padding: .25rem;
      background: #23231F; border: 1px solid rgba(255,255,255,.1); border-radius: 10px;
    }
    .vis-filter-btn {
      background: none; border: none; border-radius: 7px; cursor: pointer;
      font-family: inherit; font-size: .72rem; font-weight: 600;
      letter-spacing: .04em; color: rgba(255,255,255,.6);
      padding: .45rem .9rem; transition: background .15s, color .15s;
    }
    .vis-filter-btn:hover { color: #ffffff; background: rgba(255,255,255,.06); }
    .vis-filter-btn.is-on { background: rgba(201,168,76,.18); color: #e8c97a; }
    .vis-filter-btn:focus-visible { outline: 2px solid #c9a84c; outline-offset: 2px; }
    .vis-count { opacity: .6; margin-left: .25rem; font-variant-numeric: tabular-nums; }

    .adm-empty {
      display: none;
      text-align: center; color: rgba(255,255,255,.45);
      font-size: .85rem; padding: 3rem 1rem;
      border: 1px dashed rgba(255,255,255,.15); border-radius: 12px;
    }

    .btn-new {
      background: #c9a84c; border-radius: 8px; color: #000000;
      font-family: var(--font-body); font-size: .8rem; font-weight: 700; text-decoration: none;
      padding: .65rem 1.4rem; transition: background .15s, transform .15s;
      letter-spacing: .06em; text-transform: uppercase;
      box-shadow: 0 4px 14px rgba(201,168,76,.3);
    }
    .btn-new:hover { background: #e8c97a; transform: translateY(-1px); }

    /* BADGES DE SECCIÓN */
    .adm-ops { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .85rem; }
    .adm-op {
      font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
      padding: .25rem .6rem; border-radius: 6px; border: 1px solid;
    }
    .adm-op-corp { color: #60a5fa; border-color: rgba(96,165,250,.4);  background: rgba(96,165,250,.15); }
    .adm-op-rent { color: #34d399; border-color: rgba(52,211,153,.4);  background: rgba(52,211,153,.15); }
    .adm-op-sale { color: #c9a84c; border-color: rgba(201,168,76,.4);  background: rgba(201,168,76,.15); }
    .adm-op-none { color: rgba(255,255,255,.4); border-color: rgba(255,255,255,.15); background: rgba(255,255,255,.05); }

    /* PRECIOS */
    .adm-prices {
      display: flex; flex-direction: column; gap: .25rem;
      font-size: .78rem; color: rgba(255,255,255,.55); margin-bottom: 1rem;
    }
    .adm-prices strong { color: rgba(255,255,255,.85); font-weight: 600; }
    .adm-warn { color: #f59e0b; }

    /* STATUS TOGGLE */
    .status-row { display: flex; gap: .4rem; margin-bottom: .75rem; }
    .status-btn {
      flex: 1;
      border: none;
      border-radius: 5px;
      font-family: inherit;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      padding: .45rem .3rem;
      cursor: pointer;
      opacity: .35;
      transition: opacity .15s, transform .1s;
    }
    .status-btn:hover { opacity: .65; }
    .status-btn.active { opacity: 1; }
    .status-btn:active { transform: scale(.97); }
    .status-btn.s-available { background: #10b981; color: #fff; }
    .status-btn.s-partial   { background: #f59e0b; color: #000; }
    .status-btn.s-occupied  { background: #ef4444; color: #fff; }

    /* BADGE TEXT */
    .badge-row { display: flex; gap: .4rem; align-items: center; margin-bottom: .85rem; }
    .badge-input {
      flex: 1;
      background: #111;
      border: 1px solid #333;
      border-radius: 5px;
      color: #fff;
      font-family: inherit;
      font-size: .78rem;
      padding: .45rem .7rem;
      outline: none;
      transition: border-color .2s;
    }
    .badge-input:focus { border-color: #c9a84c; }
    .save-badge-btn {
      background: #c9a84c;
      border: none;
      border-radius: 5px;
      color: #000;
      font-family: inherit;
      font-size: .7rem;
      font-weight: 700;
      padding: .45rem .75rem;
      cursor: pointer;
      white-space: nowrap;
      transition: background .2s;
    }
    .save-badge-btn:hover { background: #b8953d; }

    /* EDIT LINK */
    .adm-card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: .75rem;
      border-top: 1px solid #222;
    }
    .adm-meta { font-size: .7rem; color: rgba(255,255,255,.35); }
    .adm-card-actions { display: flex; align-items: center; gap: .5rem; }

    /* TOGGLE DE VISIBILIDAD */
    .btn-vis {
      font-family: inherit; font-size: .72rem; font-weight: 600;
      background: transparent; color: rgba(255,255,255,.6);
      border: 1px solid rgba(255,255,255,.22); border-radius: 4px;
      padding: .3rem .7rem; cursor: pointer; white-space: nowrap;
      transition: background .2s, color .2s, border-color .2s;
    }
    .btn-vis:hover { background: rgba(255,255,255,.08); color: #ffffff; border-color: rgba(255,255,255,.4); }
    .btn-vis:focus-visible { outline: 2px solid #c9a84c; outline-offset: 2px; }
    .adm-card.is-hidden .btn-vis { color: #6ee7b7; border-color: rgba(16,185,129,.5); }
    .adm-card.is-hidden .btn-vis:hover { background: rgba(16,185,129,.14); color: #a7f3d0; border-color: rgba(16,185,129,.8); }

    .btn-edit {
      font-size: .72rem;
      font-weight: 600;
      color: #c9a84c;
      text-decoration: none;
      border: 1px solid rgba(201,168,76,.35);
      border-radius: 4px;
      padding: .3rem .7rem;
      transition: background .2s;
    }
    .btn-edit:hover { background: rgba(201,168,76,.1); }

    /* TOAST */
    #toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      background: #10b981;
      color: #fff;
      font-size: .8rem;
      font-weight: 600;
      padding: .7rem 1.2rem;
      border-radius: 6px;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity .2s, transform .2s;
      pointer-events: none;
      z-index: 9999;
    }
    #toast.show { opacity: 1; transform: translateY(0); }
    #toast.error { background: #ef4444; }
  </style>

  <main class="adm-main">

    <div class="adm-toolbar">
      <div class="vis-filter" role="group" aria-label="Filtrar por visibilidad">
        <button class="vis-filter-btn is-on" type="button" data-filter="all" onclick="filterVis(this)">
          Todas <span class="vis-count" data-count="all">{all.length}</span>
        </button>
        <button class="vis-filter-btn" type="button" data-filter="visible" onclick="filterVis(this)">
          Visibles <span class="vis-count" data-count="visible">{visiblesCount}</span>
        </button>
        <button class="vis-filter-btn" type="button" data-filter="hidden" onclick="filterVis(this)">
          Ocultas <span class="vis-count" data-count="hidden">{ocultasCount}</span>
        </button>
      </div>
      <a class="btn-new" href="/admin/propiedades/nueva/">+ Nueva propiedad</a>
    </div>

    <div class="adm-sections">
      {complejos.length > 0 && (
        <section class="adm-section">
          <div class="adm-section-title">Complejos Residenciales</div>
          <div class="adm-grid">
            {complejos.map((p: any) => <AdminPropertyCard p={p} />)}
          </div>
        </section>
      )}

      {edificios.length > 0 && (
        <section class="adm-section">
          <div class="adm-section-title">Edificios Pampa</div>
          <div class="adm-grid">
            {edificios.map((p: any) => <AdminPropertyCard p={p} />)}
          </div>
        </section>
      )}

      {otras.length > 0 && (
        <section class="adm-section">
          <div class="adm-section-title">Venta y alquiler permanente</div>
          <div class="adm-grid">
            {otras.map((p: any) => <AdminPropertyCard p={p} />)}
          </div>
        </section>
      )}
    </div>

    <div class="adm-empty" id="adm-empty">No hay propiedades en este filtro.</div>

  </main>

  <div id="toast">Guardado</div>

  <script define:vars={{ SUPABASE_URL, SUPABASE_ANON, token }}>
    function cardOf(el) {
      return el.closest('[data-id]');
    }

    function showToast(msg, isError) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = isError ? 'error' : '';
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2200);
    }

    async function patch(id, data) {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/properties?id=eq.${id}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON,
          'Authorization': `Bearer ${token}`,
          'Prefer': 'return=minimal',
        },
        body: JSON.stringify(data),
      });
      return res.ok;
    }

    async function setStatus(btn) {
      const card   = cardOf(btn);
      const id     = card.dataset.id;
      const status = btn.dataset.status;

      card.querySelectorAll('.status-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const ok = await patch(id, { status });
      showToast(ok ? '✓ Estado actualizado' : 'Error al guardar', !ok);
    }

    async function saveBadge(btn) {
      const card  = cardOf(btn);
      const id    = card.dataset.id;
      const input = card.querySelector('.badge-input');
      const text  = input.value.trim();

      const ok = await patch(id, { status_text: text });
      showToast(ok ? '✓ Badge guardado' : 'Error al guardar', !ok);
    }

    /* ── VISIBILIDAD PÚBLICA ────────────────────────────────────────────
       `active` es lo único que separa una propiedad guardada de una
       publicada: la vista `properties_public` filtra `where active`, así que
       apagarlo la saca de todo el sitio sin borrar el registro ni las fotos. */

    let currentFilter = 'all';

    function applyFilter(mode) {
      currentFilter = mode;

      document.querySelectorAll('.vis-filter-btn').forEach(b =>
        b.classList.toggle('is-on', b.dataset.filter === mode));

      document.querySelectorAll('.adm-card').forEach(card => {
        const isVisible = card.dataset.active === 'true';
        const show = mode === 'all' || (mode === 'visible') === isVisible;
        card.hidden = !show;
      });

      // Una sección sin cards a la vista sólo dejaría el título colgado.
      document.querySelectorAll('.adm-section').forEach(sec => {
        sec.hidden = !sec.querySelector('.adm-card:not([hidden])');
      });

      const nothing = !document.querySelector('.adm-card:not([hidden])');
      document.getElementById('adm-empty').style.display = nothing ? 'block' : 'none';
    }

    function filterVis(btn) {
      applyFilter(btn.dataset.filter);
      try { localStorage.setItem('admVisFilter', currentFilter); } catch (_) {}
    }

    function refreshCounts() {
      const cards   = document.querySelectorAll('.adm-card');
      const visible = document.querySelectorAll('.adm-card[data-active="true"]').length;
      document.querySelector('[data-count="all"]').textContent     = cards.length;
      document.querySelector('[data-count="visible"]').textContent = visible;
      document.querySelector('[data-count="hidden"]').textContent  = cards.length - visible;
    }

    async function toggleVisible(btn) {
      const card = cardOf(btn);
      const id   = card.dataset.id;
      const next = card.dataset.active !== 'true';   // estado al que vamos

      btn.disabled = true;
      const ok = await patch(id, { active: next });
      btn.disabled = false;

      if (!ok) {
        showToast('Error al cambiar la visibilidad', true);
        return;
      }

      card.dataset.active = String(next);
      card.classList.toggle('is-hidden', !next);
      btn.textContent = next ? 'Ocultar' : 'Mostrar';
      btn.title = next
        ? 'Sacar del sitio público sin borrarla: queda guardada acá'
        : 'Volver a mostrarla en el sitio público';

      refreshCounts();
      applyFilter(currentFilter);
      showToast(next ? '✓ Visible en el sitio' : '✓ Oculta del sitio público');
    }

    window.setStatus     = setStatus;
    window.saveBadge     = saveBadge;
    window.toggleVisible = toggleVisible;
    window.filterVis     = filterVis;

    let savedFilter = 'all';
    try { savedFilter = localStorage.getItem('admVisFilter') || 'all'; } catch (_) {}
    applyFilter(['all', 'visible', 'hidden'].includes(savedFilter) ? savedFilter : 'all');
  </script>
</AdminLayout>
