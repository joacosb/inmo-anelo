---
export const prerender = false;
import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL  = 'https://qwhasgdxhvdavnofmisf.supabase.co';
const SUPABASE_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF3aGFzZ2R4aHZkYXZub2ZtaXNmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkyNTI3MTgsImV4cCI6MjA5NDgyODcxOH0.Mj_lqGEtMhipASfO3YuBfVoCJ-f6fybOqLRw8OywCnw';

const token = Astro.cookies.get('sb_token')!.value;
const sb = createClient(SUPABASE_URL, SUPABASE_ANON, {
  global: { headers: { Authorization: `Bearer ${token}` } },
});

const { id } = Astro.params;
let saved = false;
let saveError = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const updates = {
    name:           form.get('name')?.toString()           ?? '',
    status:         form.get('status')?.toString()         ?? 'available',
    status_text:    form.get('status_text')?.toString()    ?? '',
    description:    form.get('description')?.toString()    ?? '',
    zone:           form.get('zone')?.toString()            ?? 'centro',
    max_guests:     Number(form.get('max_guests'))          || null,
    unit_count:     Number(form.get('unit_count'))          || null,
    matterport_url: form.get('matterport_url')?.toString()  || null,
  };
  const { error } = await sb.from('properties').update(updates).eq('id', id);
  if (error) saveError = error.message;
  else saved = true;
}

const { data: p } = await sb.from('properties').select('*').eq('id', id).single();
if (!p) return Astro.redirect('/admin/propiedades/');
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{p.name} · Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Montserrat', sans-serif; background: #0d0d0d; color: #fff; min-height: 100vh; }
    .adm-header {
      background: #111; border-bottom: 1px solid #222;
      padding: .9rem 2rem; display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; z-index: 100;
    }
    .adm-logo { font-size: .7rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: #c9a84c; }
    .adm-back { color: rgba(255,255,255,.5); font-size: .75rem; text-decoration: none; }
    .adm-back:hover { color: #fff; }
    .adm-main { max-width: 760px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
    .adm-page-title { font-size: 1.3rem; font-weight: 700; margin-bottom: .3rem; }
    .adm-page-sub { font-size: .75rem; color: rgba(255,255,255,.4); margin-bottom: 2rem; }

    /* ── PREVIEW CARD ── */
    .preview-wrap {
      display: grid; grid-template-columns: 260px 1fr; gap: 1.5rem; align-items: start;
      margin-bottom: 1.5rem;
    }
    .preview-card {
      border-radius: 10px; overflow: hidden; background: #fff;
      box-shadow: 0 4px 20px rgba(0,0,0,.4); flex-shrink: 0;
    }
    .preview-img-wrap { position: relative; aspect-ratio: 4/3; overflow: hidden; background: #222; cursor: move; user-select: none; }
    .preview-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; transition: opacity .15s; pointer-events: none; }
    .preview-img-wrap.dragging { cursor: grabbing; }
    .preview-pos-label { font-size: .62rem; color: rgba(255,255,255,.28); text-align: center; margin-top: .3rem; font-variant-numeric: tabular-nums; }
    .preview-status {
      position: absolute; top: .6rem; right: .6rem;
      font-size: .65rem; font-weight: 700; padding: .25rem .55rem; border-radius: 20px;
      letter-spacing: .04em;
    }
    .preview-status.disponible    { background: rgba(16,185,129,.9); color: #fff; }
    .preview-status.ocupado       { background: rgba(239,68,68,.9);  color: #fff; }
    .preview-status.parcialmente-ocupado { background: rgba(245,158,11,.9); color: #fff; }
    .preview-body { padding: .8rem 1rem; background: #fff; }
    .preview-name { font-size: .9rem; font-weight: 700; color: #111; margin-bottom: .25rem; }
    .preview-hint { font-size: .68rem; color: rgba(255,255,255,.35); margin-top: .3rem; }
    .preview-label {
      font-size: .6rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
      color: #c9a84c; margin-bottom: .6rem;
    }

    /* ── FOTOS ── */
    .section-heading {
      font-size: .65rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase;
      color: #c9a84c; padding-bottom: .6rem; border-bottom: 1px solid #222; margin-bottom: 1.25rem;
    }
    .photos-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .75rem;
      margin-bottom: 1.25rem;
    }
    .photo-item { position: relative; border-radius: 8px; overflow: hidden; aspect-ratio: 4/3; background: #1a1a1a; }
    .photo-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .photo-cover-badge {
      position: absolute; top: 6px; left: 6px;
      background: #c9a84c; color: #000; font-size: .6rem; font-weight: 700;
      letter-spacing: .08em; text-transform: uppercase; padding: .2rem .5rem; border-radius: 4px;
    }
    .photo-actions {
      position: absolute; bottom: 0; left: 0; right: 0;
      display: flex; gap: .3rem; padding: .4rem;
      background: linear-gradient(transparent, rgba(0,0,0,.75));
      opacity: 0; transition: opacity .2s;
    }
    .photo-item:hover .photo-actions { opacity: 1; }
    .photo-item[draggable] { cursor: grab; }
    .photo-item.is-dragging { opacity: .35; cursor: grabbing; }
    .photo-item.drag-over { outline: 2px solid #c9a84c; outline-offset: -2px; }
    .photo-item.editing { outline: 2px solid #c9a84c; outline-offset: -2px; }
    .photo-item.editing .photo-drag-handle { background: rgba(201,168,76,.8); color: #000; }
    .photo-drag-handle {
      position: absolute; top: 5px; left: 5px; z-index: 5;
      background: rgba(0,0,0,.55); color: rgba(255,255,255,.8);
      border-radius: 3px; padding: 2px 5px; font-size: .8rem;
      line-height: 1; pointer-events: none; letter-spacing: .05em;
    }
    .photo-btn {
      flex: 1; border: none; border-radius: 4px; font-family: inherit; font-size: .65rem;
      font-weight: 700; padding: .35rem; cursor: pointer; transition: background .15s;
    }
    .photo-btn-cover { background: #c9a84c; color: #000; }
    .photo-btn-cover:hover { background: #b8953d; }
    .photo-btn-delete { background: rgba(239,68,68,.85); color: #fff; }
    .photo-btn-delete:hover { background: #dc2626; }

    /* ── UPLOAD ── */
    .upload-area {
      border: 2px dashed #333; border-radius: 8px; padding: 2rem 1rem;
      text-align: center; cursor: pointer; transition: border-color .2s, background .2s;
      margin-bottom: 2rem;
    }
    .upload-area:hover, .upload-area.drag-over { border-color: #c9a84c; background: rgba(201,168,76,.04); }
    .upload-area input { display: none; }
    .upload-icon { font-size: 1.8rem; margin-bottom: .5rem; opacity: .4; }
    .upload-label { font-size: .8rem; color: rgba(255,255,255,.5); }
    .upload-label strong { color: #c9a84c; }
    #upload-progress { margin-top: .75rem; font-size: .75rem; color: rgba(255,255,255,.5); min-height: 1.2em; }

    /* ── FORM ── */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-grid .full { grid-column: 1 / -1; }
    .field { display: flex; flex-direction: column; gap: .4rem; }
    label { font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.45); }
    input[type=text], input[type=number], input[type=url], textarea, select {
      background: #1a1a1a; border: 1px solid #2a2a2a; border-radius: 6px; color: #fff;
      font-family: inherit; font-size: .88rem; padding: .65rem .9rem; outline: none;
      transition: border-color .2s; width: 100%;
    }
    input:focus, textarea:focus, select:focus { border-color: #c9a84c; }
    textarea { min-height: 90px; resize: vertical; }
    select option { background: #1a1a1a; }
    .divider { border: none; border-top: 1px solid #222; margin: 1.5rem 0; }
    .form-actions { display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem; }
    .btn-save {
      background: #c9a84c; border: none; border-radius: 6px; color: #000;
      font-family: inherit; font-size: .85rem; font-weight: 700; padding: .8rem 2rem;
      cursor: pointer; transition: background .2s;
    }
    .btn-save:hover { background: #b8953d; }
    .btn-cancel { color: rgba(255,255,255,.4); font-size: .8rem; text-decoration: none; }
    .btn-cancel:hover { color: #fff; }
    .alert { border-radius: 6px; font-size: .8rem; padding: .7rem 1rem; margin-bottom: 1.5rem; }
    .alert-ok    { background: rgba(16,185,129,.15); border: 1px solid rgba(16,185,129,.4); color: #6ee7b7; }
    .alert-error { background: rgba(239,68,68,.15);  border: 1px solid rgba(239,68,68,.4);  color: #f87171; }

    /* ── TOAST ── */
    #toast {
      position: fixed; bottom: 1.5rem; right: 1.5rem; background: #10b981; color: #fff;
      font-size: .8rem; font-weight: 600; padding: .7rem 1.2rem; border-radius: 6px;
      opacity: 0; transform: translateY(8px); transition: opacity .2s, transform .2s;
      pointer-events: none; z-index: 9999;
    }
    #toast.show { opacity: 1; transform: translateY(0); }
    #toast.error { background: #ef4444; }

    @media (max-width: 600px) {
      .form-grid { grid-template-columns: 1fr; }
      .form-grid .full { grid-column: 1; }
      .photos-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <header class="adm-header">
    <span class="adm-logo">Inmobiliaria Añelo · Admin</span>
    <a class="adm-back" href="/admin/propiedades/">← Volver</a>
  </header>

  <main class="adm-main">
    <div class="adm-page-title">{p.name}</div>
    <div class="adm-page-sub">Editar datos y fotos de esta propiedad</div>

    {saved     && <div class="alert alert-ok">✓ Cambios guardados correctamente.</div>}
    {saveError && <div class="alert alert-error">Error: {saveError}</div>}

    <!-- FOTOS -->
    <div class="section-heading">Fotos</div>

    <div class="preview-wrap">
      <div>
        <div class="preview-label">Previsualización del card</div>
        <div class="preview-card">
          <div class="preview-img-wrap">
            <img id="preview-img" src={p.cover_image ?? ''} alt={p.name} />
            <span class={`preview-status ${p.status === 'available' ? 'disponible' : p.status === 'occupied' ? 'ocupado' : 'parcialmente-ocupado'}`}>
              ● {p.status_text}
            </span>
          </div>
          <div class="preview-body">
            <div class="preview-name">{p.name}</div>
          </div>
        </div>
        <div class="preview-pos-label" id="pos-label">arrastrá para reencuadrar</div>
        <div class="preview-hint">Hacé <strong style="color:#c9a84c">click</strong> en una foto para fijarla y ajustar su encuadre en el carrusel. Hover para previsualizar.</div>
      </div>
      <div class="photos-grid" id="photos-grid" style="margin-bottom:0">
      {(p.images ?? []).map((url: string) => (
        <div class="photo-item" data-url={url} draggable="true"
          onmouseenter="previewCover(this.dataset.url)"
          onmouseleave="previewCover(null)">
          <img src={url} alt="" loading="lazy" />
          <span class="photo-drag-handle">⠿</span>
          {url === p.cover_image && <span class="photo-cover-badge">Portada</span>}
          <div class="photo-actions">
            {url !== p.cover_image && (
              <button class="photo-btn photo-btn-cover" onclick="setCover(this)">Portada</button>
            )}
            <button class="photo-btn photo-btn-delete" onclick="deletePhoto(this)">Eliminar</button>
          </div>
        </div>
      ))}
      </div>
    </div>

    <div class="upload-area" id="upload-area" onclick="document.getElementById('file-input').click()"
      ondragover="event.preventDefault();this.classList.add('drag-over')"
      ondragleave="this.classList.remove('drag-over')"
      ondrop="handleDrop(event)">
      <input id="file-input" type="file" accept="image/*" multiple onchange="handleFiles(this.files)" />
      <div class="upload-icon">📷</div>
      <div class="upload-label">
        <strong>Hacé click</strong> o arrastrá fotos acá<br/>
        JPG, PNG o WEBP · Máx. 10MB por imagen
      </div>
      <div id="upload-progress"></div>
    </div>

    <hr class="divider" />

    <!-- DATOS -->
    <div class="section-heading" style="margin-top:0">Datos</div>

    <form method="POST">
      <div class="form-grid">

        <div class="field full">
          <label for="name">Nombre de la propiedad</label>
          <input id="name" name="name" type="text" value={p.name} required />
        </div>

        <div class="field">
          <label for="status">Estado</label>
          <select id="status" name="status">
            <option value="available" selected={p.status === 'available'}>🟢 Disponible</option>
            <option value="partial"   selected={p.status === 'partial'}>🟡 Parcialmente ocupado</option>
            <option value="occupied"  selected={p.status === 'occupied'}>🔴 Ocupado</option>
          </select>
        </div>

        <div class="field">
          <label for="status_text">Texto del badge</label>
          <input id="status_text" name="status_text" type="text"
            value={p.status_text} placeholder="ej: ¡Quedan 2!" required />
        </div>

        <div class="field full">
          <label for="description">Descripción</label>
          <textarea id="description" name="description">{p.description}</textarea>
        </div>

        <hr class="divider full" />

        <div class="field">
          <label for="max_guests">Máx. huéspedes</label>
          <input id="max_guests" name="max_guests" type="number" min="1"
            value={p.max_guests ?? ''} placeholder="ej: 24" />
        </div>

        <div class="field">
          <label for="unit_count">Cantidad de UFs</label>
          <input id="unit_count" name="unit_count" type="number" min="1"
            value={p.unit_count ?? ''} placeholder="ej: 6" />
        </div>

        <div class="field">
          <label for="zone">Zona</label>
          <select id="zone" name="zone">
            <option value="centro"    selected={p.zone === 'centro'}>Centro / Añelo</option>
            <option value="forestada" selected={p.zone === 'forestada'}>La Forestada</option>
          </select>
        </div>

        <div class="field">
          <label for="matterport_url">Link Recorrido Virtual (Matterport)</label>
          <input id="matterport_url" name="matterport_url" type="url"
            value={p.matterport_url ?? ''} placeholder="https://my.matterport.com/…" />
        </div>

      </div>

      <div class="form-actions">
        <button class="btn-save" type="submit">Guardar cambios</button>
        <a class="btn-cancel" href="/admin/propiedades/">Cancelar</a>
      </div>
    </form>
  </main>

  <div id="toast">Guardado</div>

  <script define:vars={{ SUPABASE_URL, SUPABASE_ANON, token, propertyId: p.id, initialCover: p.cover_image, initialImages: p.images ?? [], initialPosition: p.cover_position ?? '50% 50%', initialImagePositions: p.image_positions ?? [] }}>
    let currentImages    = [...initialImages];
    let currentCover     = initialCover;
    let coverPosition    = initialPosition;
    // Per-image positions parallel to currentImages; fallback to cover_position for cover, else '50% 50%'
    let currentPositions = initialImages.map(function(url, i) {
      return initialImagePositions[i] || (url === initialCover ? initialPosition : '50% 50%');
    });
    let previewingUrl    = null; // which photo is currently hovered in the grid
    let pinnedPhotoUrl   = null; // photo locked in preview via click for position editing
    let isDraggingPhoto  = false; // true while drag-reorder is in progress

    // Apply saved position to preview on load
    document.getElementById('preview-img').style.objectPosition = coverPosition;

    // ── DRAG TO REPOSITION (preview panel) ──────────────────
    var previewFrame = document.querySelector('.preview-img-wrap');
    var isReposDrag  = false;

    previewFrame.addEventListener('mousedown', function(e) {
      if (e.button !== 0) return;
      e.preventDefault();
      isReposDrag = true;
      previewFrame.classList.add('dragging');
      applyDragPos(e.clientX, e.clientY);
    });
    document.addEventListener('mousemove', function(e) {
      if (!isReposDrag) return;
      applyDragPos(e.clientX, e.clientY);
    });
    document.addEventListener('mouseup', async function() {
      if (!isReposDrag) return;
      isReposDrag = false;
      previewFrame.classList.remove('dragging');
      var patches = { image_positions: currentPositions };
      var targetUrl = previewingUrl || currentCover;
      if (targetUrl === currentCover) patches.cover_position = coverPosition;
      const ok = await patchProperty(patches);
      if (ok) showToast('✓ Encuadre guardado');
      else    showToast('Error al guardar', true);
    });

    previewFrame.addEventListener('touchstart', function(e) {
      isReposDrag = true;
      applyDragPos(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });
    document.addEventListener('touchmove', function(e) {
      if (!isReposDrag) return;
      applyDragPos(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });
    document.addEventListener('touchend', async function() {
      if (!isReposDrag) return;
      isReposDrag = false;
      var patches = { image_positions: currentPositions };
      var targetUrl = previewingUrl || currentCover;
      if (targetUrl === currentCover) patches.cover_position = coverPosition;
      const ok = await patchProperty(patches);
      if (ok) showToast('✓ Encuadre guardado');
      else    showToast('Error al guardar', true);
    });

    function applyDragPos(clientX, clientY) {
      var rect = previewFrame.getBoundingClientRect();
      var x = Math.round(Math.max(0, Math.min(100, (clientX - rect.left)  / rect.width  * 100)));
      var y = Math.round(Math.max(0, Math.min(100, (clientY - rect.top)   / rect.height * 100)));
      var pos = x + '% ' + y + '%';
      var targetUrl = previewingUrl || currentCover;
      var idx = currentImages.indexOf(targetUrl);
      if (idx >= 0) currentPositions[idx] = pos;
      if (targetUrl === currentCover) coverPosition = pos;
      document.getElementById('preview-img').style.objectPosition = pos;
      var labelEl = document.getElementById('pos-label');
      var targetUrl2 = previewingUrl || currentCover;
      if (targetUrl2 && targetUrl2 !== currentCover) {
        var n2 = currentImages.indexOf(targetUrl2) + 1;
        labelEl.textContent = 'Foto ' + n2 + ' · ' + x + '% · ' + y + '%';
      } else {
        labelEl.textContent = x + '% · ' + y + '%';
      }
    }

    function previewCover(url) {
      if (isDraggingPhoto || pinnedPhotoUrl) return; // ignore hover when dragging or a photo is pinned
      previewingUrl = url;
      showInPreview(url);
    }

    function showInPreview(url) {
      var img = document.getElementById('preview-img');
      img.style.opacity = '0';
      setTimeout(function() {
        img.src = url ?? currentCover ?? '';
        var pos;
        if (url) {
          var idx = currentImages.indexOf(url);
          pos = (idx >= 0 && currentPositions[idx]) ? currentPositions[idx] : '50% 50%';
        } else {
          pos = coverPosition;
        }
        img.style.objectPosition = pos;
        var labelEl = document.getElementById('pos-label');
        if (!url || url === currentCover) {
          labelEl.textContent = pos === '50% 50%' ? 'arrastrá para reencuadrar' : pos;
        } else {
          var n = currentImages.indexOf(url) + 1;
          labelEl.textContent = 'Foto ' + n + ' de ' + currentImages.length + (pos !== '50% 50%' ? ' · ' + pos : ' · arrastrá para reencuadrar');
        }
        img.style.opacity = '1';
      }, 80);
    }

    function showToast(msg, isError) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = isError ? 'error show' : 'show';
      setTimeout(() => t.classList.remove('show'), isError ? 6000 : 2500);
    }

    async function patchProperty(data) {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/properties?id=eq.${propertyId}`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON,
          'Authorization': `Bearer ${token}`,
          'Prefer': 'return=minimal',
        },
        body: JSON.stringify(data),
      });
      return res.ok;
    }

    async function syncImages() {
      var patches = { images: currentImages, cover_image: currentCover, image_positions: currentPositions };
      var coverIdx = currentImages.indexOf(currentCover);
      if (coverIdx >= 0) { patches.cover_position = currentPositions[coverIdx]; coverPosition = currentPositions[coverIdx]; }
      return patchProperty(patches);
    }

    // ── DRAG-TO-REORDER photos ───────────────────────────────
    var dragSrcUrl = null;

    function setupDragHandlers(item) {
      item.setAttribute('draggable', 'true');

      // Click to pin/unpin photo for carousel position editing
      item.addEventListener('click', function(e) {
        if (e.target.closest('button')) return;
        var url = item.dataset.url;
        if (pinnedPhotoUrl === url) {
          // Unpin — revert to cover preview
          pinnedPhotoUrl = null;
          previewingUrl  = null;
          item.classList.remove('editing');
          showInPreview(null);
        } else {
          document.querySelectorAll('.photo-item.editing').forEach(function(el) { el.classList.remove('editing'); });
          pinnedPhotoUrl = url;
          previewingUrl  = url;
          item.classList.add('editing');
          showInPreview(url);
        }
      });

      item.addEventListener('dragstart', function(e) {
        dragSrcUrl = item.dataset.url;
        isDraggingPhoto = true;
        e.dataTransfer.effectAllowed = 'move';
        setTimeout(function() { item.classList.add('is-dragging'); }, 0);
      });
      item.addEventListener('dragend', function() {
        item.classList.remove('is-dragging');
        document.querySelectorAll('.photo-item').forEach(function(i) { i.classList.remove('drag-over'); });
        isDraggingPhoto = false;
      });
      item.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        document.querySelectorAll('.photo-item').forEach(function(i) { i.classList.remove('drag-over'); });
        if (item.dataset.url !== dragSrcUrl) item.classList.add('drag-over');
      });
      item.addEventListener('drop', async function(e) {
        e.preventDefault();
        item.classList.remove('drag-over');
        var targetUrl = item.dataset.url;
        if (!dragSrcUrl || dragSrcUrl === targetUrl) return;

        var grid = document.getElementById('photos-grid');
        var srcEl = grid.querySelector('[data-url="' + CSS.escape(dragSrcUrl) + '"]');
        if (!srcEl) return;

        var items = Array.from(grid.querySelectorAll('.photo-item'));
        var srcDomIdx = items.indexOf(srcEl);
        var tgtDomIdx = items.indexOf(item);

        // Move DOM element
        if (srcDomIdx < tgtDomIdx) {
          grid.insertBefore(srcEl, item.nextSibling);
        } else {
          grid.insertBefore(srcEl, item);
        }

        // Rebuild arrays from new DOM order
        var posMap = {};
        currentImages.forEach(function(u, i) { posMap[u] = currentPositions[i] || '50% 50%'; });
        currentImages    = Array.from(grid.querySelectorAll('.photo-item')).map(function(el) { return el.dataset.url; });
        currentPositions = currentImages.map(function(u) { return posMap[u] || '50% 50%'; });

        const ok = await syncImages();
        if (ok) showToast('✓ Orden guardado');
        else    showToast('Error al guardar', true);
      });
    }

    // Set up drag handlers on existing photos
    document.querySelectorAll('.photo-item').forEach(setupDragHandlers);

    // ── UPLOAD ──────────────────────────────────────────────
    function handleDrop(e) {
      e.preventDefault();
      document.getElementById('upload-area').classList.remove('drag-over');
      handleFiles(e.dataTransfer.files);
    }

    async function handleFiles(files) {
      const progress = document.getElementById('upload-progress');
      const arr = Array.from(files);
      for (let i = 0; i < arr.length; i++) {
        const file = arr[i];
        progress.textContent = `Subiendo ${i + 1} de ${arr.length}: ${file.name}…`;
        try {
          const url = await uploadFile(file);
          currentImages.push(url);
          currentPositions.push('50% 50%');
          if (!currentCover) currentCover = url;
          appendPhotoCard(url);
        } catch (e) {
          console.error('Upload error:', e);
          showToast(`Error al subir ${file.name}: ${e.message}`, true);
        }
      }
      const ok = await syncImages();
      progress.textContent = '';
      if (!ok) console.error('syncImages failed — DB update rejected');
      showToast(ok ? `✓ ${arr.length} foto${arr.length > 1 ? 's' : ''} agregada${arr.length > 1 ? 's' : ''}` : 'Error al guardar en base de datos', !ok);
    }

    async function uploadFile(file) {
      const ext      = file.name.split('.').pop();
      const filename = `${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`;
      const path     = `${propertyId}/${filename}`;
      const res = await fetch(`${SUPABASE_URL}/storage/v1/object/property-images/${path}`, {
        method: 'POST',
        headers: {
          'apikey': SUPABASE_ANON,
          'Authorization': `Bearer ${token}`,
          'Content-Type': file.type,
          'x-upsert': 'false',
        },
        body: file,
      });
      if (!res.ok) throw new Error(await res.text());
      return `${SUPABASE_URL}/storage/v1/object/public/property-images/${path}`;
    }

    function appendPhotoCard(url) {
      const grid = document.getElementById('photos-grid');
      const div  = document.createElement('div');
      div.className = 'photo-item';
      div.dataset.url = url;
      div.setAttribute('draggable', 'true');
      div.innerHTML = `
        <img src="${url}" alt="" loading="lazy" />
        <span class="photo-drag-handle">⠿</span>
        <div class="photo-actions">
          <button class="photo-btn photo-btn-cover" onclick="setCover(this)">Portada</button>
          <button class="photo-btn photo-btn-delete" onclick="deletePhoto(this)">Eliminar</button>
        </div>`;
      div.addEventListener('mouseenter', function() { previewCover(url); });
      div.addEventListener('mouseleave', function() { previewCover(null); });
      setupDragHandlers(div);
      grid.appendChild(div);
      if (currentImages.length === 1) refreshCoverBadges();
    }

    // ── PORTADA ─────────────────────────────────────────────
    async function setCover(btn) {
      const item = btn.closest('.photo-item');
      currentCover = item.dataset.url;
      var coverIdx = currentImages.indexOf(currentCover);
      coverPosition = (coverIdx >= 0 && currentPositions[coverIdx]) ? currentPositions[coverIdx] : '50% 50%';
      var img = document.getElementById('preview-img');
      img.src = currentCover;
      img.style.objectPosition = coverPosition;
      document.getElementById('pos-label').textContent = coverPosition === '50% 50%' ? 'arrastrá para reencuadrar' : coverPosition;
      const ok = await syncImages();
      if (ok) { refreshCoverBadges(); showToast('✓ Portada actualizada'); }
      else showToast('Error al guardar', true);
    }

    function refreshCoverBadges() {
      document.querySelectorAll('.photo-item').forEach(item => {
        item.querySelector('.photo-cover-badge')?.remove();
        const actions = item.querySelector('.photo-actions');
        const coverBtn = actions.querySelector('.photo-btn-cover');
        if (item.dataset.url === currentCover) {
          const badge = document.createElement('span');
          badge.className = 'photo-cover-badge';
          badge.textContent = 'Portada';
          item.prepend(badge);
          coverBtn?.remove();
        } else if (!coverBtn) {
          const btn = document.createElement('button');
          btn.className = 'photo-btn photo-btn-cover';
          btn.textContent = 'Portada';
          btn.setAttribute('onclick', 'setCover(this)');
          actions.prepend(btn);
        }
        // re-apply editing class after DOM refresh
        if (item.dataset.url === pinnedPhotoUrl) item.classList.add('editing');
      });
    }

    // expose to window for inline HTML handlers
    window.handleFiles  = handleFiles;
    window.handleDrop   = handleDrop;
    window.setCover     = setCover;
    window.deletePhoto  = deletePhoto;
    window.previewCover = previewCover;

    // ── ELIMINAR ─────────────────────────────────────────────
    async function deletePhoto(btn) {
      const item = btn.closest('.photo-item');
      const url  = item.dataset.url;

      if (url.includes('/storage/v1/object/public/property-images/')) {
        const path = url.split('/property-images/')[1];
        await fetch(`${SUPABASE_URL}/storage/v1/object/property-images/${path}`, {
          method: 'DELETE',
          headers: { 'apikey': SUPABASE_ANON, 'Authorization': `Bearer ${token}` },
        });
      }

      var idx = currentImages.indexOf(url);
      currentImages    = currentImages.filter(u => u !== url);
      currentPositions.splice(idx, 1);
      if (currentCover === url) currentCover = currentImages[0] ?? null;
      if (pinnedPhotoUrl === url) { pinnedPhotoUrl = null; previewingUrl = null; }
      item.remove();

      const ok = await syncImages();
      if (ok) { refreshCoverBadges(); showToast('✓ Foto eliminada'); }
      else showToast('Error al guardar', true);
    }
  </script>
</body>
</html>
