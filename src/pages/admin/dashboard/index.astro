---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL  = 'https://qwhasgdxhvdavnofmisf.supabase.co';
const SUPABASE_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF3aGFzZ2R4aHZkYXZub2ZtaXNmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkyNTI3MTgsImV4cCI6MjA5NDgyODcxOH0.Mj_lqGEtMhipASfO3YuBfVoCJ-f6fybOqLRw8OywCnw';

const token = Astro.cookies.get('sb_token')!.value;
const sb = createClient(SUPABASE_URL, SUPABASE_ANON, {
  global: { headers: { Authorization: `Bearer ${token}` } },
});

let propStats = { available: 0, partial: 0, occupied: 0, total: 0 };
let homepageStats = { active: 0, total: 0 };

const { data: props } = await sb.from('properties').select('status, active');
if (props) {
  const active = props.filter((p: any) => p.active);
  propStats.total     = active.length;
  propStats.available = active.filter((p: any) => p.status === 'available').length;
  propStats.partial   = active.filter((p: any) => p.status === 'partial').length;
  propStats.occupied  = active.filter((p: any) => p.status === 'occupied').length;
}

try {
  const { data: cards } = await sb.from('homepage_cards').select('active');
  if (cards) {
    homepageStats.total  = cards.length;
    homepageStats.active = cards.filter((c: any) => c.active).length;
  }
} catch (_) {}
---
<AdminLayout title="Dashboard" section="dashboard">
  <style>
    .dash-main { max-width: 860px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
    .dash-heading { font-size: 1.4rem; font-weight: 700; margin-bottom: .35rem; }
    .dash-sub { font-size: .8rem; color: rgba(255,255,255,.38); margin-bottom: 2.5rem; }
    .dash-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }

    .dash-card {
      background: #111;
      border: 1px solid #1e1e1e;
      border-radius: 12px;
      padding: 1.5rem 1.4rem 1.3rem;
      display: flex;
      flex-direction: column;
      gap: .6rem;
      transition: border-color .2s;
    }
    .dash-card:hover { border-color: #2a2a2a; }
    .dash-card-label {
      font-size: .58rem;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: #c9a84c;
    }
    .dash-card-title { font-size: 1.05rem; font-weight: 700; margin-bottom: .1rem; }
    .dash-card-desc { font-size: .74rem; color: rgba(255,255,255,.38); line-height: 1.55; }

    .dash-stats { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .2rem; }
    .stat-chip {
      font-size: .62rem;
      font-weight: 700;
      padding: .22rem .6rem;
      border-radius: 20px;
      letter-spacing: .04em;
    }
    .stat-chip.available { background: rgba(16,185,129,.18); color: #6ee7b7; }
    .stat-chip.partial   { background: rgba(234,179,8,.18);  color: #fde68a; }
    .stat-chip.occupied  { background: rgba(239,68,68,.18);  color: #fca5a5; }
    .stat-chip.neutral   { background: rgba(255,255,255,.08); color: rgba(255,255,255,.5); }

    .dash-card-btn {
      display: inline-block;
      margin-top: .5rem;
      background: #c9a84c;
      color: #000;
      font-family: inherit;
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      padding: .55rem 1.2rem;
      border-radius: 6px;
      text-decoration: none;
      transition: background .15s;
      align-self: flex-start;
    }
    .dash-card-btn:hover { background: #b8953d; }

    .dash-card-new {
      display: inline-block;
      margin-top: .2rem;
      margin-left: .75rem;
      color: rgba(201,168,76,.7);
      font-size: .72rem;
      font-weight: 600;
      text-decoration: none;
      transition: color .15s;
    }
    .dash-card-new:hover { color: #c9a84c; }
  </style>

  <main class="dash-main">
    <div class="dash-heading">Panel de administración</div>
    <p class="dash-sub">Seleccioná una sección para gestionar el contenido del sitio.</p>

    <div class="dash-grid">

      <!-- Propiedades -->
      <div class="dash-card">
        <div class="dash-card-label">Sección · Corporativo</div>
        <div class="dash-card-title">Propiedades</div>
        <div class="dash-card-desc">Complejos, edificios y UFs con fotos, estado y descripción.</div>
        <div class="dash-stats">
          <span class="stat-chip available">{propStats.available} disponible{propStats.available !== 1 ? 's' : ''}</span>
          {propStats.partial > 0 && <span class="stat-chip partial">{propStats.partial} parcial{propStats.partial !== 1 ? 'es' : ''}</span>}
          {propStats.occupied > 0 && <span class="stat-chip occupied">{propStats.occupied} ocupada{propStats.occupied !== 1 ? 's' : ''}</span>}
          <span class="stat-chip neutral">{propStats.total} activa{propStats.total !== 1 ? 's' : ''}</span>
        </div>
        <div>
          <a href="/admin/propiedades/" class="dash-card-btn">Gestionar →</a>
        </div>
      </div>

      <!-- Homepage Cards -->
      <div class="dash-card">
        <div class="dash-card-label">Sección · Homepage</div>
        <div class="dash-card-title">Portafolio</div>
        <div class="dash-card-desc">Cards de las categorías que aparecen en la página principal (UFs, Complejos, Edificios, Lotes).</div>
        <div class="dash-stats">
          <span class="stat-chip available">{homepageStats.active} activa{homepageStats.active !== 1 ? 's' : ''}</span>
          <span class="stat-chip neutral">{homepageStats.total} en total</span>
        </div>
        <div>
          <a href="/admin/homepage/" class="dash-card-btn">Gestionar →</a>
          <a href="/admin/homepage/nueva" class="dash-card-new">+ Nueva card</a>
        </div>
      </div>

    </div>
  </main>
</AdminLayout>
