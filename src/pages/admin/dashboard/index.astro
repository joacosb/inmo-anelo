---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL  = 'https://qwhasgdxhvdavnofmisf.supabase.co';
const SUPABASE_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF3aGFzZ2R4aHZkYXZub2ZtaXNmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkyNTI3MTgsImV4cCI6MjA5NDgyODcxOH0.Mj_lqGEtMhipASfO3YuBfVoCJ-f6fybOqLRw8OywCnw';

const token = Astro.cookies.get('sb_token')!.value;
const sb = createClient(SUPABASE_URL, SUPABASE_ANON, {
  global: { headers: { Authorization: `Bearer ${token}` } },
});

let propStats = { available: 0, partial: 0, occupied: 0, total: 0 };
let homepageStats = { active: 0, total: 0 };

let saleStats = { available: 0, reserved: 0, total: 0 };
let rentStats = { available: 0, total: 0 };

const { data: props } = await sb
  .from('properties')
  .select('status, active, for_corporate, for_rent, for_sale, sale_status, rent_status');
if (props) {
  const active = props.filter((p: any) => p.active);

  const corp = active.filter((p: any) => p.for_corporate);
  propStats.total     = corp.length;
  propStats.available = corp.filter((p: any) => p.status === 'available').length;
  propStats.partial   = corp.filter((p: any) => p.status === 'partial').length;
  propStats.occupied  = corp.filter((p: any) => p.status === 'occupied').length;

  const sale = active.filter((p: any) => p.for_sale);
  saleStats.total     = sale.length;
  saleStats.available = sale.filter((p: any) => p.sale_status === 'available').length;
  saleStats.reserved  = sale.filter((p: any) => p.sale_status === 'reserved').length;

  const rent = active.filter((p: any) => p.for_rent);
  rentStats.total     = rent.length;
  rentStats.available = rent.filter((p: any) => p.rent_status === 'available').length;
}

try {
  const { data: cards } = await sb.from('homepage_cards').select('active');
  if (cards) {
    homepageStats.total  = cards.length;
    homepageStats.active = cards.filter((c: any) => c.active).length;
  }
} catch (_) {}
---
<AdminLayout title="Dashboard" section="dashboard">
  <style>
    .dash-main { max-width: 980px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
    .dash-heading { font-family: var(--font-display); font-size: 2.5rem; font-weight: 600; color: #ffffff; margin-bottom: .4rem; }
    .dash-sub { font-size: .95rem; color: rgba(255,255,255,.6); font-weight: 300; margin-bottom: 3rem; }
    .dash-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.75rem; }

    .dash-card {
      background: #33332D;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 16px;
      padding: 1.8rem 1.6rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: .75rem;
      transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
      box-shadow: 0 4px 24px rgba(0,0,0,.4);
    }
    .dash-card:hover { border-color: rgba(201,168,76,.5); transform: translateY(-3px); box-shadow: 0 10px 32px rgba(201,168,76,.12); }
    .dash-card-label {
      font-size: .62rem;
      font-weight: 700;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: #c9a84c;
    }
    .dash-card-title { font-family: var(--font-display); font-size: 1.45rem; font-weight: 600; color: #ffffff; margin-bottom: .1rem; }
    .dash-card-desc { font-size: .82rem; color: rgba(255,255,255,.55); line-height: 1.6; font-weight: 300; }

    .dash-stats { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .3rem; }
    .stat-chip {
      font-size: .68rem;
      font-weight: 700;
      padding: .28rem .7rem;
      border-radius: 20px;
      letter-spacing: .04em;
    }
    .stat-chip.available { background: rgba(16,185,129,.2); color: #6ee7b7; border: 1px solid rgba(16,185,129,.3); }
    .stat-chip.partial   { background: rgba(234,179,8,.2);  color: #fde68a; border: 1px solid rgba(234,179,8,.3); }
    .stat-chip.occupied  { background: rgba(239,68,68,.2);  color: #fca5a5; border: 1px solid rgba(239,68,68,.3); }
    .stat-chip.neutral   { background: rgba(255,255,255,.1); color: rgba(255,255,255,.7); border: 1px solid rgba(255,255,255,.15); }

    .dash-card-btn {
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      margin-top: .6rem;
      background: #c9a84c;
      color: #000000;
      font-family: var(--font-body);
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      padding: .6rem 1.4rem;
      border-radius: 8px;
      text-decoration: none;
      transition: background .15s, transform .15s;
      align-self: flex-start;
      box-shadow: 0 4px 14px rgba(201,168,76,.3);
    }
    .dash-card-btn:hover { background: #e8c97a; transform: translateY(-1px); }

    .dash-card-new {
      display: inline-flex;
      align-items: center;
      margin-top: .4rem;
      margin-left: .85rem;
      color: #c9a84c;
      font-size: .78rem;
      font-weight: 600;
      text-decoration: none;
      transition: color .15s;
    }
    .dash-card-new:hover { color: #e8c97a; text-decoration: underline; }
  </style>

  <main class="dash-main">
    <div class="dash-heading">Panel de administración</div>
    <p class="dash-sub">Seleccioná una sección para gestionar el contenido del sitio.</p>

    <div class="dash-grid">

      <!-- Propiedades -->
      <div class="dash-card">
        <div class="dash-card-label">Sección · Corporativo</div>
        <div class="dash-card-title">Propiedades</div>
        <div class="dash-card-desc">Complejos, edificios y UFs con fotos, estado y descripción.</div>
        <div class="dash-stats">
          <span class="stat-chip available">{propStats.available} disponible{propStats.available !== 1 ? 's' : ''}</span>
          {propStats.partial > 0 && <span class="stat-chip partial">{propStats.partial} parcial{propStats.partial !== 1 ? 'es' : ''}</span>}
          {propStats.occupied > 0 && <span class="stat-chip occupied">{propStats.occupied} ocupada{propStats.occupied !== 1 ? 's' : ''}</span>}
          <span class="stat-chip neutral">{propStats.total} activa{propStats.total !== 1 ? 's' : ''}</span>
        </div>
        <div>
          <a href="/admin/propiedades/" class="dash-card-btn">Gestionar →</a>
        </div>
      </div>

      <!-- Venta -->
      <div class="dash-card">
        <div class="dash-card-label">Sección · Venta</div>
        <div class="dash-card-title">Propiedades en venta</div>
        <div class="dash-card-desc">Casas, departamentos, terrenos y locales publicados en /venta/.</div>
        <div class="dash-stats">
          <span class="stat-chip available">{saleStats.available} en venta</span>
          {saleStats.reserved > 0 && <span class="stat-chip partial">{saleStats.reserved} reservada{saleStats.reserved !== 1 ? 's' : ''}</span>}
          <span class="stat-chip neutral">{saleStats.total} en total</span>
        </div>
        <div>
          <a href="/admin/propiedades/" class="dash-card-btn">Gestionar →</a>
          <a href="/admin/propiedades/nueva/" class="dash-card-new">+ Nueva propiedad</a>
        </div>
      </div>

      <!-- Alquiler permanente -->
      <div class="dash-card">
        <div class="dash-card-label">Sección · Alquiler</div>
        <div class="dash-card-title">Alquiler permanente</div>
        <div class="dash-card-desc">Casas y departamentos publicados en /alquiler/ con contrato particular.</div>
        <div class="dash-stats">
          <span class="stat-chip available">{rentStats.available} disponible{rentStats.available !== 1 ? 's' : ''}</span>
          <span class="stat-chip neutral">{rentStats.total} en total</span>
        </div>
        <div>
          <a href="/admin/propiedades/" class="dash-card-btn">Gestionar →</a>
        </div>
      </div>

      <!-- Homepage Cards -->
      <div class="dash-card">
        <div class="dash-card-label">Sección · Homepage</div>
        <div class="dash-card-title">Portafolio</div>
        <div class="dash-card-desc">Cards de las categorías que aparecen en la página principal (UFs, Complejos, Edificios, Lotes).</div>
        <div class="dash-stats">
          <span class="stat-chip available">{homepageStats.active} activa{homepageStats.active !== 1 ? 's' : ''}</span>
          <span class="stat-chip neutral">{homepageStats.total} en total</span>
        </div>
        <div>
          <a href="/admin/homepage/" class="dash-card-btn">Gestionar →</a>
          <a href="/admin/homepage/nueva" class="dash-card-new">+ Nueva card</a>
        </div>
      </div>

    </div>
  </main>
</AdminLayout>
