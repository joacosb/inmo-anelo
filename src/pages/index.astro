---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL  = 'https://qwhasgdxhvdavnofmisf.supabase.co';
const SUPABASE_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF3aGFzZ2R4aHZkYXZub2ZtaXNmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkyNTI3MTgsImV4cCI6MjA5NDgyODcxOH0.Mj_lqGEtMhipASfO3YuBfVoCJ-f6fybOqLRw8OywCnw';

const sb = createClient(SUPABASE_URL, SUPABASE_ANON);

const DEFAULT_CARDS = [
  { id:'1', tag:'Unidades Particulares', name:'UFs en centro y Forestada', description:'Unidades para 1, 2 o 4 personas totalmente equipadas con todos los servicios.', status:'available', status_text:'Disponible', cover_image:'/complejo-donostia1.webp', cover_position:'50% 50%', images:[], dest_url:'/corporativo/', meta1:'1–4 personas', meta2:'8–10% retorno est.', card_type:'uf' },
  { id:'2', tag:'Complejos Enteros',      name:'Complejos en La Forestada',   description:'Complejos completos para hasta 35 personas. Contrato corporativo Oil & Gas.',              status:'partial',    status_text:'Últimos disponibles', cover_image:'/complejo-maria1.webp',   cover_position:'50% 50%', images:[], dest_url:'/corporativo/', meta1:'4–35 personas', meta2:'10–12% retorno est.', card_type:'complejo' },
  { id:'3', tag:'Edificios · Downtown',  name:'Edificios Pampa I, II y III', description:'Departamentos de 1 y 2 dormitorios en el microcentro de Añelo.',                            status:'available',   status_text:'Disponible',          cover_image:'/edificio-pampa3.webp',  cover_position:'50% 50%', images:[], dest_url:'/corporativo/#secEdificios', meta1:'20–78 personas', meta2:'9–11% retorno est.', card_type:'edificio' },
  { id:'4', tag:'Lotes',                 name:'Loteo La Forestada',          description:'Lotes de 540 m² a 5 minutos del centro de Añelo. Ideal para construir o revalorizar.',       status:'available',   status_text:'Disponible',          cover_image:'',                       cover_position:'50% 50%', images:[], dest_url:'/invertir/', meta1:'540 m²', meta2:'A 5 min del centro', card_type:'lote' },
];

function statusClass(s: string) {
  if (s === 'available') return 'disponible';
  if (s === 'occupied')  return 'ocupado';
  return 'parcialmente-ocupado';
}

let homepageCards: any[] = DEFAULT_CARDS;
try {
  const { data, error } = await sb.from('homepage_cards').select('*').eq('active', true).order('sort_order');
  if (!error && data && data.length > 0) homepageCards = data;
} catch(_) {}
---
<Layout
  title="Inmobiliaria Añelo | Alquiler Corporativo Oil & Gas · Inversión en Vaca Muerta"
  description="Alquiler corporativo para empresas Oil & Gas en Añelo, Neuquén. Complejos, edificios y departamentos equipados. Retorno 10–12% anual en USD. Cotizá en menos de 24 hs. +25 años en la Patagonia."
  pathname="/"
  preloadHero={true}
>

  <!-- HERO -->
  <div class="hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-badge">Vaca Muerta · Añelo · Neuquén</div>
      <h1>Invertí donde el<br/><em>petróleo</em> mueve<br/>la economía</h1>
      <p>Unidades residenciales y corporativas en el corazón del yacimiento más importante de Sudamérica. Rentabilidad en dólares, alta demanda.</p>
      <div class="hero-actions">
        <a class="btn-primary" href="/corporativo/">Ver Propiedades</a>
        <a class="btn-outline" href="/invertir/">Ver Retornos</a>
        <a class="btn-outline hero-action-tertiary" href="#por-que-anelo">¿Por qué Añelo?</a>
      </div>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><strong>8–12%</strong><span>Rentabilidad anual en USD</span></div>
      <div class="hero-stat"><strong>+25 años</strong><span>Experiencia en la Patagonia</span></div>
      <div class="hero-stat"><strong>Alta</strong><span>Demanda corporativa</span></div>
      <div class="hero-stat"><strong>2° reserva</strong><span>Shale del mundo · Vaca Muerta</span></div>
    </div>
  </div>

  <!-- QUICK CTA STRIP -->
  <div class="quick-cta-strip">
    <a class="quick-cta-btn alquilar" href="/corporativo/">
      <i data-lucide="key-round" class="cta-icon"></i>
      <span>
        Alquilar
        <span class="cta-sub">Ver propiedades disponibles</span>
      </span>
    </a>
    <a class="quick-cta-btn comprar" href="/invertir/">
      <i data-lucide="trending-up" class="cta-icon"></i>
      <span>
        Comprar / Invertir
        <span class="cta-sub">Conoce los retornos y contactanos</span>
      </span>
    </a>
  </div>

  <!-- STATS MOBILE: solo visible en mobile, debajo del strip -->
  <div class="hero-stats-mobile">
    <div class="hero-stat"><strong>8–12%</strong><span>Rentabilidad anual en USD</span></div>
    <div class="hero-stat"><strong>+25 años</strong><span>Experiencia en la Patagonia</span></div>
    <div class="hero-stat"><strong>Alta</strong><span>Demanda corporativa</span></div>
    <div class="hero-stat"><strong>2° reserva</strong><span>Shale del mundo · Vaca Muerta</span></div>
  </div>

  <div class="ticker-bar" role="marquee" aria-label="Información de contacto y servicios">
    <div class="ticker-track">
      <span class="ticker-item"><span class="ticker-dot">◆</span>Cotizá tu alquiler en menos de 24 hs</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Soluciones para empresas y particulares</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Alquiler corporativo Oil &amp; Gas — Vaca Muerta</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Invertí en Añelo desde USD 35.000 — 10–12% anual</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Complejos, edificios y UFs totalmente equipados</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>+25 años de trayectoria en la Patagonia</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Contratanos hoy y empezá a generar rentabilidad</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Gestión integral — Vós invertís, nosotros administramos</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Cotizá tu alquiler en menos de 24 hs</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Soluciones para empresas y particulares</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Alquiler corporativo Oil &amp; Gas — Vaca Muerta</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Invertí en Añelo desde USD 35.000 — 10–12% anual</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Complejos, edificios y UFs totalmente equipados</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>+25 años de trayectoria en la Patagonia</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Contratanos hoy y empezá a generar rentabilidad</span>
      <span class="ticker-item"><span class="ticker-dot">◆</span>Gestión integral — Vós invertís, nosotros administramos</span>
    </div>
  </div>

  <!-- PAMPA III DESTACADO -->
  <section class="featured-pampa" id="pampa-iii">
    <div class="fp-top-strip">
      <span class="fp-strip-label"><i data-lucide="star"></i>Oportunidad Destacada</span>
      <span class="fp-avail-pill"><span class="fp-pulse"></span>Disponibilidad inmediata</span>
    </div>
    <div class="fp-inner">
      <div class="fp-img-col">
        <img src="/edificio-pampa3.webp" alt="Edificio Pampa III · Centro de Añelo" loading="eager" decoding="async" />
        <div class="fp-location-tag"><i data-lucide="map-pin"></i>Centro de Añelo</div>
      </div>
      <div class="fp-text-col">
        <span class="fp-eyebrow">Edificio Corporativo · Downtown</span>
        <h2 class="fp-heading">Edificio <em>Pampa III</em></h2>
        <p class="fp-desc">En el corazón de Añelo — a pasos de todo, sin perder tiempo en traslados. Ideal para equipos Oil &amp; Gas que necesitan comodidad, practicidad y servicios completos desde el primer día.</p>
        <div class="fp-chips">
          <span class="fp-chip"><i data-lucide="users"></i>Hasta 78 personas</span>
          <span class="fp-chip"><i data-lucide="bed-double"></i>1 dormitorio y monoambientes</span>
          <span class="fp-chip"><i data-lucide="layers"></i>Alquilá por piso o edificio completo</span>
          <span class="fp-chip"><i data-lucide="wifi"></i>Todos los servicios incluidos</span>
        </div>
        <div class="fp-actions">
          <a class="btn-primary" href="/corporativo/#edificios" onclick="gtag('event','cta_pampa3_featured',{'event_category':'destacado'});">Ver disponibilidad</a>
          <a class="fp-wa-btn" href="https://wa.me/5492972431619?text=Hola%2C%20me%20interesa%20el%20Edificio%20Pampa%20III.%20%C2%BFPueden%20darme%20m%C3%A1s%20informaci%C3%B3n%3F" target="_blank" rel="noopener" onclick="gtag('event','whatsapp_click',{'event_category':'destacado'});gtag('event','conversion',{'send_to':'AW-17170667639/kKlFCJvU_JccEPewzvs_','value':1.0,'currency':'ARS'})"><i data-lucide="message-circle"></i>Consultar por WhatsApp</a>
          <a class="fp-tour-btn" href="https://my.matterport.com/show/?m=HdzbizKQMrt" target="_blank" rel="noopener" onclick="gtag('event','virtual_tour_pampa3',{'event_category':'destacado'});"><i data-lucide="play-circle"></i>Recorrido virtual</a>
        </div>
      </div>
    </div>
  </section>

  <!-- POR QUE ANELO -->
  <section id="por-que-anelo" style="background:var(--black); color:var(--white);">
    <div class="section-label reveal">La oportunidad</div>
    <div class="section-title reveal" style="color:var(--white);"><em>Vaca Muerta:</em><br/>la oportunidad del siglo</div>
    <div class="gold-divider reveal"></div>
    <p class="section-sub reveal" style="color:rgba(255,255,255,.6);">Vaca Muerta es la segunda reserva de shale gas y la cuarta de shale oil del planeta. Las inversiones proyectadas superan los USD 100.000 millones en la próxima década. Añelo es la puerta de entrada a todo ese movimiento.</p>
    <div class="why-grid reveal">
      <div class="why-card" style="background:rgba(255,255,255,.05); border-color:var(--gold);"><div class="icon"><i data-lucide="globe-2"></i></div><h3 style="color:var(--white);">2° reserva mundial</h3><p style="color:rgba(255,255,255,.55);">Vaca Muerta es la segunda reserva de shale del mundo, solo comparable con Permian Basin en Texas.</p></div>
      <div class="why-card" style="background:rgba(255,255,255,.05); border-color:var(--gold);"><div class="icon"><i data-lucide="trending-up"></i></div><h3 style="color:var(--white);">Crecimiento sostenido</h3><p style="color:rgba(255,255,255,.55);">YPF, Shell, TotalEnergies, Chevron y Pan American Energy operan en la cuenca. La actividad crece año a año.</p></div>
      <div class="why-card" style="background:rgba(255,255,255,.05); border-color:var(--gold);"><div class="icon"><i data-lucide="bar-chart-2"></i></div><h3 style="color:var(--white);">Rentabilidad elevada</h3><p style="color:rgba(255,255,255,.55);">Retornos de 8 a 12% anual respaldados por contratos corporativos. Una de las rentabilidades inmobiliarias más altas del país.</p></div>
      <div class="why-card" style="background:rgba(255,255,255,.05); border-color:var(--gold);"><div class="icon"><i data-lucide="key-round"></i></div><h3 style="color:var(--white);">Empezás a cobrar sin esfuerzo</h3><p style="color:rgba(255,255,255,.55);">Nosotros conseguimos el inquilino, firmamos el contrato y te transferimos la renta. Tu propiedad trabaja por vos.</p></div>
    </div>
  </section>

  <!-- PROPIEDADES PREVIEW -->
  <section id="nuestros-complejos" style="background:var(--light); padding-top:4rem; padding-bottom:4rem;">
    <div class="section-label reveal">Portafolio</div>
    <div class="section-title reveal">Nuestro <em>portafolio</em></div>
    <div class="gold-divider reveal"></div>
    <p class="section-sub reveal">Cuatro categorías de inversión para distintos perfiles de capital. Todos con servicios incluidos y gestión profesional.</p>
    <div class="props-grid props-grid--home reveal">
      {homepageCards.map((card: any) => (
        <div class="prop-card"
          data-name={card.name}
          data-type={card.card_type ?? 'complejo'}
          data-section="complejos"
          data-dest={card.dest_url}>
          <div class="prop-img-wrap">
            {card.cover_image
              ? <img class="prop-img" loading="lazy" decoding="async" src={card.cover_image} alt={card.name} style={`object-position:${card.cover_position ?? '50% 50%'}`} />
              : <div class="prop-img-placeholder"><span>{card.tag}</span></div>
            }
          </div>
          <span class={`prop-status ${statusClass(card.status)}`}>● {card.status_text}</span>
          <div class="prop-body">
            <span class="prop-tag">{card.tag}</span>
            <h3>{card.name}</h3>
            <p>{card.description}</p>
            <div class="prop-meta">
              {card.meta1 && <div class="prop-meta-item"><strong>{card.meta1}</strong></div>}
              {card.meta2 && <div class="prop-meta-item"><strong>{card.meta2}</strong></div>}
            </div>
          </div>
        </div>
      ))}
    </div>
    <div style="text-align:center; margin-top:2.5rem;">
      <a class="btn-primary" href="/corporativo/">Ver todas las propiedades</a>
    </div>
  </section>

  <!-- PASOS -->
  <section id="como-invierto">
    <div class="section-label reveal">Proceso</div>
    <div class="section-title reveal">Invertir es <em>simple</em></div>
    <div class="gold-divider reveal"></div>
    <p class="section-sub reveal">Te acompañamos en cada etapa. Sin burocracia innecesaria, con total transparencia.</p>
    <div class="steps reveal">
      <div class="step"><div class="step-num" aria-hidden="true">01</div><h4>Consulta inicial</h4><p>Analizamos tu perfil de inversión y te presentamos las opciones que mejor se adaptan a tu capital disponible.</p></div>
      <div class="step"><div class="step-num" aria-hidden="true">02</div><h4>Visita o tour virtual</h4><p>Conocés la propiedad presencialmente o mediante recorrida virtual HD. Sin presión, a tu ritmo.</p></div>
      <div class="step"><div class="step-num" aria-hidden="true">03</div><h4>Escritura y financiación</h4><p>Gestionamos el proceso legal completo y te asesoramos sobre opciones de pago y financiación disponibles.</p></div>
      <div class="step"><div class="step-num" aria-hidden="true">04</div><h4>Tu renta llega</h4><p>Conseguimos el inquilino corporativo, firmamos el contrato y empézas a cobrar desde el primer mes.</p></div>
    </div>
  </section>
</Layout>
