---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { supabase, PUBLIC_TABLE, statusClass, zoneLabel } from '../lib/supabase';
import type { Property } from '../lib/supabase';

let propiedades: any[] = [];

try {
  const { data, error } = await supabase
    .from(PUBLIC_TABLE)
    .select('*')
    .or('name.ilike.%Abedules%,name.ilike.%Hondarribia%,name.ilike.%Pampa II%')
    .eq('active', true)
    .order('sort_order');
  if (error) throw error;
  propiedades = data ?? [];
} catch (e: any) {
  console.error('[invertir] Supabase error:', e?.message);
}
---
<Layout
  title="Invertir en Vaca Muerta | Retornos 10-12% en USD - Inmobiliaria Añelo"
  description="Invertí en propiedades en Añelo, Neuquén con retornos del 10-12% anual en USD. Complejos, edificios y unidades funcionales con contratos corporativos Oil & Gas. Renta desde el primer mes."
  pathname="/invertir/"
