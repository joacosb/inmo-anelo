            <img class="prop-img" loading="lazy" decoding="async" src={p.cover_image} alt={p.name}
              style={`object-position: ${p.cover_position ?? '50% 50%'}`} />
            {p.images?.length > 1 && (
              <>
                <button class="car-btn car-prev" aria-label="Anterior">&#8249;</button>
                <button class="car-btn car-next" aria-label="Siguiente">&#8250;</button>
                <div class="car-dots">{p.images.map((_: string, i: number) => <span class={`car-dot${i === 0 ? ' active' : ''}`}></span>)}</div>
