<script is:inline>
  // ─── CARRUSEL DE CARD ──────────────────────────────────────
  document.querySelectorAll('.prop-img-wrap[data-images]').forEach(function(wrap) {
    var imgs = JSON.parse(wrap.dataset.images);
    if (imgs.length <= 1) return;
    var positions = JSON.parse(wrap.dataset.positions || '[]');
    var idx = 0;
    var dots = wrap.querySelectorAll('.car-dot');

    // Cross-fade: dos capas superpuestas
    var imgA = wrap.querySelector('.prop-img');
    var layerStyle = 'position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;object-fit:cover;display:block;transition:opacity .35s ease;';
    var initPos = imgA.style.objectPosition || '50% 50%';
    imgA.style.cssText = layerStyle + 'opacity:1;object-position:' + initPos;
    var imgB = document.createElement('img');
    imgB.className = 'prop-img';
    imgB.alt = imgA.alt;
    imgB.decoding = 'async';
    imgB.style.cssText = layerStyle + 'opacity:0;object-position:' + initPos;
    imgA.after(imgB);
    var activeImg = imgA, inactiveImg = imgB;

    var preloaded = {};
    preloaded[0] = true;
    function preloadImg(i) { if (preloaded[i]) return; preloaded[i] = true; (new Image()).src = imgs[i]; }
    function preloadWindow(c) { preloadImg((c+1)%imgs.length); preloadImg((c-1+imgs.length)%imgs.length); }
    preloadWindow(0);

    function go(n) {
      idx = (idx + n + imgs.length) % imgs.length;
      var next = imgs[idx], nextPos = positions[idx] || '50% 50%', targetIdx = idx;
      var cur = { a: activeImg, b: inactiveImg };
      function swap() {
        cur.b.style.objectPosition = nextPos;
        cur.b.style.opacity = '1';
        cur.a.style.opacity = '0';
        activeImg = cur.b; inactiveImg = cur.a;
        dots.forEach(function(d, i) { d.classList.toggle('active', i === targetIdx); });
        preloadWindow(targetIdx);
      }
      cur.b.src = next;
      var tmp = new Image();
      tmp.onload = swap; tmp.src = next;
      if (tmp.complete) swap();
    }
    wrap.querySelector('.car-prev').addEventListener('click', function(e) { e.stopPropagation(); go(-1); });
    wrap.querySelector('.car-next').addEventListener('click', function(e) { e.stopPropagation(); go(1); });
    var touchStartX = 0;
    wrap.addEventListener('touchstart', function(e) { touchStartX = e.touches[0].clientX; }, { passive: true });
    wrap.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) { e.stopPropagation(); go(dx > 0 ? -1 : 1); }
    });
  });

  // ─── DETAIL MODAL ──────────────────────────────────────────
  var dmImgs = []; var dmIdx = 0; var dmLastCard = null;
  function dmPreload(imgs) { imgs.forEach(function(src) { (new Image()).src = src; }); }
  function openDM(card) {
    dmLastCard = card;
    dmImgs = JSON.parse(card.dataset.images || '[]');
    dmIdx = 0;
    dmPreload(dmImgs);
    var imgEl = document.getElementById('dmImg');
    imgEl.style.opacity = '1'; imgEl.src = dmImgs[0] || '';
    var dotsEl = document.getElementById('dmDots');
    dotsEl.innerHTML = '';
    if (dmImgs.length > 1) {
      dmImgs.forEach(function(_, i) {
        var d = document.createElement('span');
        d.className = 'dm-dot' + (i === 0 ? ' active' : '');
        d.addEventListener('click', function() { dmJump(i); });
        dotsEl.appendChild(d);
      });
    }
    document.querySelector('.dm-prev').style.display = dmImgs.length > 1 ? '' : 'none';
    document.querySelector('.dm-next').style.display = dmImgs.length > 1 ? '' : 'none';
    document.getElementById('dmName').textContent = card.dataset.name || '';
    document.getElementById('dmDesc').textContent = card.dataset.desc || '';
    var statusEl = document.getElementById('dmStatus');
    statusEl.textContent = '● ' + (card.dataset.status || '');
    statusEl.className = 'prop-status dm-status-badge ' + (card.dataset.statusClass || '');
    var gEl = document.getElementById('dmGuests');
    gEl.style.display = card.dataset.guests ? '' : 'none';
    document.getElementById('dmGuestsVal').textContent = 'Hasta ' + card.dataset.guests;
    var uEl = document.getElementById('dmUnits');
    uEl.style.display = card.dataset.units ? '' : 'none';
    document.getElementById('dmUnitsVal').textContent = card.dataset.units;
    var zEl = document.getElementById('dmZone');
    zEl.style.display = card.dataset.zone ? '' : 'none';
    document.getElementById('dmZoneVal').textContent = card.dataset.zone;
    var name = card.dataset.name || '';
    var waMsg = encodeURIComponent('Hola! Me interesa invertir en ' + name + '.');
    document.getElementById('dmWA').href = 'https://wa.me/5492972431619?text=' + waMsg;
    document.getElementById('dmMail').href = 'mailto:grupopampanqn@gmail.com?subject=' + encodeURIComponent('Invertir en ' + name) + '&body=' + encodeURIComponent('Hola, estuve en el sitio web y me interesa invertir en ' + name + '. ¿Podrían enviarme más información?');
    var tourEl = document.getElementById('dmTour');
    tourEl.style.display = card.dataset.matterport ? '' : 'none';
    if (card.dataset.matterport) tourEl.href = card.dataset.matterport;
    document.getElementById('detailModal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeDM() {
    document.getElementById('detailModal').classList.remove('open');
    document.body.style.overflow = '';
    if (dmLastCard) { dmLastCard.setAttribute('tabindex', '-1'); dmLastCard.focus({ preventScroll: true }); dmLastCard = null; }
  }
  function dmGo(n) { dmIdx = (dmIdx + n + dmImgs.length) % dmImgs.length; dmUpdate(); }
  function dmJump(i) { dmIdx = i; dmUpdate(); }
  function dmUpdate() {
    var imgEl = document.getElementById('dmImg');
    imgEl.style.opacity = '0';
    var next = dmImgs[dmIdx];
    var tmp = new Image();
    tmp.onload = function() { imgEl.src = next; imgEl.style.opacity = '1'; };
    tmp.src = next;
    if (tmp.complete) { imgEl.src = next; imgEl.style.opacity = '1'; }
    document.querySelectorAll('.dm-dot').forEach(function(d, i) { d.classList.toggle('active', i === dmIdx); });
  }
  document.querySelectorAll('.prop-card--detail').forEach(function(card) {
    card.addEventListener('click', function(e) {
      if (e.target.closest('a, button')) return;
      openDM(card);
    });
  });
  document.addEventListener('keydown', function(e) {
    if (!document.getElementById('detailModal').classList.contains('open')) return;
    if (e.key === 'Escape') closeDM();
    if (e.key === 'ArrowLeft')  dmGo(-1);
    if (e.key === 'ArrowRight') dmGo(1);
  });
</script>

<script is:inline>
  // ─── FAQ ACCORDION ────────────────────────────────────────────────────
  (function() {
    document.querySelectorAll('.faq-q').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var item = btn.closest('.faq-item');
        var isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(function(el) {
          el.classList.remove('open');
          el.querySelector('.faq-q').setAttribute('aria-expanded', 'false');
          var ans = el.querySelector('.faq-a');
          ans.style.maxHeight = '0';
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
          var ans = item.querySelector('.faq-a');
          ans.style.maxHeight = ans.scrollHeight + 'px';
        }
      });
    });
  })();

  // ─── SCROLL-BUILD ANIMATION ────────────────────────────────────────────
  (function() {
    var section = document.getElementById('scrollBuild');
    if (!section) return;
    var svg = section.querySelector('.build-svg');
    var bricksG = document.getElementById('buildBricks');
    var stages = section.querySelectorAll('.build-stage');
    var pBar = section.querySelector('.build-progress-bar');

    if (bricksG && !bricksG.children.length) {
      var rows = 6, cols = 6;
      var bw = 36, bh = 16;
      var startX = 290, baseY = 325;
      var html = '';
      for (var r = 0; r < rows; r++) {
        for (var c = 0; c < cols; c++) {
          var x = startX + c * bw;
          var y = baseY - (r + 1) * bh;
          var s = 0.30 + (r / rows) * 0.21 + (c / cols) * 0.012;
          html += '<rect class="brick" x="' + x + '" y="' + y + '" width="' + (bw - 1) + '" height="' + (bh - 1) + '" style="--s:' + s.toFixed(3) + '"/>';
        }
      }
      bricksG.innerHTML = html;
    }

    var ticking = false;
    var lastStage = -1;

    function update() {
      if (!section.offsetParent) { ticking = false; return; }
      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight;
      var sectionH = section.offsetHeight;
      var scrollable = sectionH - vh;
      if (scrollable <= 0) { ticking = false; return; }
      var distance = 70 - rect.top;
      var p = Math.min(1, Math.max(0, distance / scrollable));
      svg.style.setProperty('--p', p.toFixed(4));
      if (pBar) pBar.style.setProperty('--p', p.toFixed(4));

      var idx;
      if (p < 0.13) idx = 0;
      else if (p < 0.28) idx = 1;
      else if (p < 0.54) idx = 2;
      else if (p < 0.70) idx = 3;
      else if (p < 0.88) idx = 4;
      else idx = 5;

      if (idx !== lastStage) {
        stages.forEach(function(s, i) {
          s.classList.toggle('active', i === idx);
          s.classList.toggle('done', i < idx);
        });
        lastStage = idx;
      }
      ticking = false;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();
</script>
