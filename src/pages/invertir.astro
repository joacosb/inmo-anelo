---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Invertir en Vaca Muerta | Retornos 10-12% en USD - Inmobiliaria Añelo"
  description="Invertí en propiedades en Añelo, Neuquén con retornos del 10-12% anual en USD. Complejos, edificios y unidades funcionales con contratos corporativos Oil & Gas. Renta desde el primer mes."
  pathname="/invertir/"
>

  <!-- SCROLL-BUILD: de lote a llave en mano -->
  <section id="scrollBuild" class="scroll-build" aria-label="Del lote a la casa terminada">
    <div class="build-sticky">
      <div class="build-copy">
        <div class="section-label">De un lote a tu renta</div>
        <h2>De un lote en <em>La&nbsp;Forestada</em><br/>a tu llave en mano.</h2>
        <div class="gold-divider"></div>
        <p style="color:var(--gray); font-size:1rem; max-width:440px; margin-bottom:.5rem;">Mirá cómo construimos tu inversión: cada ladrillo, cada terminación, pensada para rendir en dólares desde el primer mes.</p>
        <div class="build-stages" role="list">
          <div class="build-progress-bar" aria-hidden="true"></div>
          <div class="build-stage" data-stage="0" role="listitem"><span class="bs-num">01</span><span class="bs-text">El lote en La Forestada</span></div>
          <div class="build-stage" data-stage="1" role="listitem"><span class="bs-num">02</span><span class="bs-text">Replanteo y cimientos</span></div>
          <div class="build-stage" data-stage="2" role="listitem"><span class="bs-num">03</span><span class="bs-text">Levantamos los muros</span></div>
          <div class="build-stage" data-stage="3" role="listitem"><span class="bs-num">04</span><span class="bs-text">Techo y estructura</span></div>
          <div class="build-stage" data-stage="4" role="listitem"><span class="bs-num">05</span><span class="bs-text">Terminaciones y equipamiento</span></div>
          <div class="build-stage" data-stage="5" role="listitem"><span class="bs-num">06</span><span class="bs-text">Llave en mano — empezá a cobrar</span></div>
        </div>
        <div class="build-note" aria-hidden="true">◆ Añelo · Neuquén</div>
      </div>
      <div class="build-canvas">
        <svg class="build-svg" viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Construcción de una casa en La Forestada de Añelo">
          <defs>
            <linearGradient id="skyGrad" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="#fbf3e0"/>
              <stop offset="100%" stop-color="#f2dfba"/>
            </linearGradient>
            <radialGradient id="lampGrad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ffd97a" stop-opacity=".7"/>
              <stop offset="60%" stop-color="#ffd97a" stop-opacity=".2"/>
              <stop offset="100%" stop-color="#ffd97a" stop-opacity="0"/>
            </radialGradient>
            <pattern id="groundDots" x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r=".8" fill="#8a4629" opacity=".28"/>
              <circle cx="9" cy="9" r=".6" fill="#8a4629" opacity=".2"/>
            </pattern>
          </defs>

          <rect x="0" y="0" width="800" height="500" fill="url(#skyGrad)"/>

          <g class="sun">
            <circle cx="640" cy="95" r="34" fill="#e8c97a" opacity=".55"/>
            <circle cx="640" cy="95" r="22" fill="#c9a84c" opacity=".75"/>
          </g>

          <ellipse class="lamp-glow" cx="400" cy="280" rx="220" ry="140" fill="url(#lampGrad)"/>

          <g class="ground">
            <rect x="0" y="340" width="800" height="160" fill="#e2c99e"/>
            <rect x="0" y="340" width="800" height="160" fill="url(#groundDots)"/>
            <path d="M0,340 Q200,332 400,340 T800,340" stroke="#8a4629" stroke-width="1" fill="none" opacity=".3"/>
          </g>

          <g class="ground-stones" fill="#8a4629" opacity=".55">
            <ellipse cx="115" cy="395" rx="8" ry="3"/>
            <ellipse cx="230" cy="420" rx="6" ry="2.5"/>
            <ellipse cx="560" cy="410" rx="7" ry="3"/>
            <ellipse cx="685" cy="395" rx="5" ry="2"/>
            <ellipse cx="160" cy="440" rx="9" ry="3.2"/>
            <ellipse cx="620" cy="445" rx="7" ry="2.5"/>
          </g>

          <g stroke="#c9a84c" stroke-width="1.5" fill="#fbf3e0">
            <g class="poplar"><path d="M70,340 L60,180 Q58,150 70,140 Q82,150 80,180 Z" fill="#f0e0b8"/><line x1="70" y1="340" x2="70" y2="370" stroke="#8a4629" stroke-width="2"/></g>
            <g class="poplar"><path d="M135,340 L122,160 Q120,125 135,115 Q150,125 148,160 Z" fill="#f0e0b8"/><line x1="135" y1="340" x2="135" y2="375" stroke="#8a4629" stroke-width="2"/></g>
            <g class="poplar"><path d="M200,340 L190,190 Q188,162 200,152 Q212,162 210,190 Z" fill="#f0e0b8"/><line x1="200" y1="340" x2="200" y2="365" stroke="#8a4629" stroke-width="2"/></g>
            <g class="poplar"><path d="M695,340 L685,175 Q683,145 695,135 Q707,145 705,175 Z" fill="#f0e0b8"/><line x1="695" y1="340" x2="695" y2="370" stroke="#8a4629" stroke-width="2"/></g>
            <g class="poplar"><path d="M755,340 L745,200 Q743,172 755,162 Q767,172 765,200 Z" fill="#f0e0b8"/><line x1="755" y1="340" x2="755" y2="362" stroke="#8a4629" stroke-width="2"/></g>
          </g>

          <rect class="foundation-outline" x="290" y="325" width="220" height="16" fill="none" stroke="#8a4629" stroke-width="1.5" stroke-dasharray="6 4"/>

          <rect class="foundation-fill" x="290" y="333" width="220" height="10" fill="#8a4629"/>
          <rect class="foundation-fill" x="290" y="333" width="220" height="3" fill="#c08a66"/>

          <g id="buildBricks" class="layer-bricks" fill="#b86a4b" stroke="#8a4629" stroke-width=".6"></g>

          <ellipse class="ground-shadow" cx="400" cy="345" rx="140" ry="10" fill="#8a4629"/>

          <g class="roof">
            <polygon points="275,230 525,230 400,140" fill="#8a4629" stroke="#2a1608" stroke-width="1.2"/>
            <polygon points="275,230 525,230 400,140" fill="none" stroke="#c9a84c" stroke-width=".8" opacity=".4"/>
            <line x1="400" y1="140" x2="400" y2="230" stroke="#c9a84c" stroke-width=".6" opacity=".35"/>
          </g>

          <g class="chimney">
            <rect x="448" y="160" width="18" height="42" fill="#8a4629" stroke="#2a1608" stroke-width=".8"/>
            <rect x="445" y="158" width="24" height="5" fill="#2a1608"/>
          </g>

          <g class="smoke" fill="#fbf3e0" stroke="#c9a84c" stroke-width=".5" opacity=".85">
            <ellipse class="smoke-puff" cx="452" cy="140" rx="9" ry="7"/>
            <ellipse class="smoke-puff" cx="460" cy="118" rx="11" ry="8"/>
            <ellipse class="smoke-puff" cx="448" cy="96" rx="13" ry="9"/>
          </g>

          <g class="door">
            <rect x="385" y="285" width="30" height="55" fill="#8a4629" stroke="#2a1608" stroke-width=".8"/>
            <rect x="387" y="287" width="26" height="51" fill="none" stroke="#c9a84c" stroke-width=".6"/>
            <circle cx="409" cy="313" r="1.6" fill="#c9a84c"/>
            <rect x="382" y="283" width="36" height="4" fill="#c9a84c" opacity=".6"/>
          </g>

          <g class="window-frame">
            <rect x="318" y="258" width="40" height="34" fill="#f7efdc" stroke="#2a1608" stroke-width=".8"/>
            <line x1="338" y1="258" x2="338" y2="292" stroke="#2a1608" stroke-width=".6"/>
            <line x1="318" y1="275" x2="358" y2="275" stroke="#2a1608" stroke-width=".6"/>
            <rect x="314" y="254" width="48" height="4" fill="#c9a84c" opacity=".7"/>
            <rect x="442" y="258" width="40" height="34" fill="#f7efdc" stroke="#2a1608" stroke-width=".8"/>
            <line x1="462" y1="258" x2="462" y2="292" stroke="#2a1608" stroke-width=".6"/>
            <line x1="442" y1="275" x2="482" y2="275" stroke="#2a1608" stroke-width=".6"/>
            <rect x="438" y="254" width="48" height="4" fill="#c9a84c" opacity=".7"/>
          </g>

          <g class="window-light">
            <rect x="320" y="260" width="36" height="30" fill="#ffd97a"/>
            <rect x="444" y="260" width="36" height="30" fill="#ffd97a"/>
          </g>

          <g class="garden" stroke="#8a4629" stroke-width="1" fill="#e8c97a">
            <circle cx="325" cy="345" r="7" opacity=".9"/>
            <circle cx="345" cy="348" r="5" opacity=".9"/>
            <circle cx="475" cy="345" r="7" opacity=".9"/>
            <circle cx="455" cy="348" r="5" opacity=".9"/>
            <ellipse cx="400" cy="355" rx="6" ry="2" fill="#d9886a" stroke="none"/>
            <ellipse cx="400" cy="370" rx="7" ry="2.3" fill="#d9886a" stroke="none"/>
            <ellipse cx="400" cy="385" rx="8" ry="2.5" fill="#d9886a" stroke="none"/>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <section class="returns-section" id="retornos">
    <div class="section-label reveal">Por qué invertir</div>
    <div class="section-title reveal">Rentabilidad <em>real</em><br/>en dólares</div>
    <div class="gold-divider reveal"></div>
    <p class="section-sub reveal">El mercado corporativo de Vaca Muerta ofrece retornos sin comparación en el mercado inmobiliario argentino. Baja vacancia, inquilinos empresas, inversión en USD.</p>
    <div class="return-tiers">
      <div class="tier">
        <div class="tier-info"><h4>Unidad funcional individual</h4><p>La Forestada · Hasta 4 personas · Llave en mano</p></div>
        <div class="tier-yield"><strong>9–10%</strong><span>USD / año</span></div>
      </div>
      <div class="tier">
        <div class="tier-info"><h4>Complejo residencial</h4><p>La Forestada · Hasta 20 personas · Contrato con una sola empresa</p></div>
        <div class="tier-yield"><strong>10–12%</strong><span>USD / año</span></div>
      </div>
      <div class="tier">
        <div class="tier-info"><h4>Edificio de departamentos</h4><p>Centro de Añelo · Hasta 65 personas · Alta diversificación</p></div>
        <div class="tier-yield"><strong>10–12%</strong><span>USD / año</span></div>
      </div>
      <div class="tier" style="border-style: dashed; opacity: .85;">
        <div class="tier-info"><h4>Negocio hotelero o lotes para construir</h4><p>¿Tenés otra idea de inversión en Añelo? Contanos y lo analizamos juntos.</p></div>
        <a class="btn-primary" style="white-space:nowrap; flex-shrink:0;" href="/contacto/">Consultar</a>
      </div>
      <div style="margin-top:1.5rem; padding:1.25rem; border:1px dashed rgba(201,168,76,.3); border-radius:4px;">
        <p style="font-size:.82rem; color:rgba(255,255,255,.45); line-height:1.6;">* Los rendimientos son estimaciones basadas en contratos corporativos vigentes y tasas de ocupación históricas. Consultá a un asesor para proyecciones personalizadas.</p>
      </div>
    </div>
  </section>

  <section id="propiedades">
    <div class="section-label reveal">Oportunidades de inversión</div>
    <div class="section-title reveal">Propiedades <em>disponibles</em><br/>para comprar</div>
    <div class="gold-divider reveal"></div>
    <p class="section-sub reveal">Unidades listas para alquilar el día que las adquís. Toda la gestión a cargo de Inmobiliaria Añelo.</p>
    <div class="props-grid">
      <div class="prop-card" data-name="UFs en Complejo Abedules" data-type="uf" data-section="complejos" data-no-modal="1">
        <img class="prop-img" loading="lazy" decoding="async" src="https://qwhasgdxhvdavnofmisf.supabase.co/storage/v1/object/public/property-images/735b1c8b-19a9-4afc-800d-2fa7eb267481/1779296792714-cvasrnuleyb.JPEG" alt="Complejo Abedules" style="object-position:50% 50%" />
        <span class="prop-status disponible">● Disponible</span>
        <div class="prop-body">
          <span class="prop-tag">Unidad funcional</span>
          <h3>UFs en Complejo Abedules<br/>La Forestada</h3>
          <p>Unidades individuales llave en mano, totalmente equipadas. Inquilino corporativo desde el primer mes.</p>
          <div class="prop-meta">
            <div class="prop-meta-item"><strong>Hasta 4</strong>huéspedes</div>
            <div class="prop-meta-item"><strong>9–10%</strong>est. anual USD</div>
          </div>
          <a class="btn-primary" style="width:100%; margin-top:1.25rem;" href="/contacto/">Consultar precio</a>
        </div>
      </div>
      <div class="prop-card" data-name="Edificio Pampa II" data-type="edificio" data-section="edificios" data-no-modal="1">
        <img class="prop-img" loading="lazy" decoding="async" src="/edificio-pampa2.webp" alt="Edificio Pampa II" style="object-position:50% 50%" />
        <span class="prop-status disponible">● Disponible</span>
        <div class="prop-body">
          <span class="prop-tag">Edificio</span>
          <h3>Edificio Pampa II<br/>Centro Añelo</h3>
          <p>Departamentos en edificio céntrico con alta capacidad de alojamiento. Ideal para inversores que buscan escala y diversificación.</p>
          <div class="prop-meta">
            <div class="prop-meta-item"><strong>Hasta 65</strong>huéspedes</div>
            <div class="prop-meta-item"><strong>10–12%</strong>est. anual USD</div>
          </div>
          <a class="btn-primary" style="width:100%; margin-top:1.25rem;" href="/contacto/">Consultar precio</a>
        </div>
      </div>
      <div class="prop-card" data-name="Complejo Hondarribia" data-type="complejo" data-section="complejos" data-no-modal="1">
        <img class="prop-img" loading="lazy" decoding="async" src="/complejo-patagonia.webp" alt="Complejo Hondarribia" style="object-position:50% 50%" />
        <span class="prop-status disponible">● Disponible</span>
        <div class="prop-body">
          <span class="prop-tag">Complejo residencial</span>
          <h3>Complejo Hondarribia<br/>La Forestada</h3>
          <p>Complejo cerrado para hasta 20 personas. Contrato corporativo con una sola empresa, gestión integral incluida.</p>
          <div class="prop-meta">
            <div class="prop-meta-item"><strong>Hasta 20</strong>huéspedes</div>
            <div class="prop-meta-item"><strong>10–12%</strong>est. anual USD</div>
          </div>
          <a class="btn-primary" style="width:100%; margin-top:1.25rem;" href="/contacto/">Consultar precio</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section" id="faq">
    <div class="section-label reveal">Preguntas frecuentes</div>
    <div class="section-title reveal">Todo lo que querés<br/><em>saber antes de invertir</em></div>
    <div class="gold-divider reveal"></div>
    <p class="section-sub reveal">Resolvemos las dudas más comunes de nuestros inversores. Si tu pregunta no está acá, escribinos y te respondemos en menos de 24 hs.</p>
    <div class="faq-grid reveal">
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">¿Cuánto capital necesito para empezar?<span class="faq-icon" aria-hidden="true"></span></button>
        <div class="faq-a"><p>Las opciones se adaptan a distintos perfiles de inversión. Podés entrar desde <strong>USD 60 el m²</strong> en lotes, acceder a unidades funcionales para 1 a 4 personas, o invertir en complejos con capacidad de hasta 24 personas. Para inversores de mayor escala, los <strong>Edificios Pampa</strong> son una excelente alternativa: construcción de calidad en el centro de Añelo, ideal para empresas que necesitan alojar a todo su equipo.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">¿Qué pasa si no consiguen inquilino para mi propiedad?<span class="faq-icon" aria-hidden="true"></span></button>
        <div class="faq-a"><p>La demanda corporativa en Añelo es muy atractiva: ingenieros, ejecutivos y trabajadores de Oil &amp; Gas necesitan alojamiento permanente. Incluso es posible comprar una propiedad con contrato vigente desde el día uno. Si eventualmente queda libre, nos encargamos de mantenerla operativa y conseguir el próximo inquilino — vos no te ocupás de nada.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">¿Cómo funciona el contrato corporativo?<span class="faq-icon" aria-hidden="true"></span></button>
        <div class="faq-a"><p>El contrato se firma con <strong>empresas, no con particulares</strong>, lo que da mayor seguridad al inversor. Nosotros negociamos la tarifa, gestionamos toda la parte legal y nos hacemos cargo de los gastos operativos. Vos cobrás, nosotros administramos.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">¿Cuánto tiempo tarda en concretarse la compra?<span class="faq-icon" aria-hidden="true"></span></button>
        <div class="faq-a"><p>El proceso típico lleva entre <strong>30 y 60 días</strong> desde la reserva hasta la escritura. Toda la documentación legal la gestionamos con un estudio de confianza. Si la unidad ya tiene contrato corporativo vigente al momento de la compra, empezás a cobrar desde el primer mes de concretada la operación.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">¿Puedo vender la propiedad después?<span class="faq-icon" aria-hidden="true"></span></button>
        <div class="faq-a"><p>Sí. Todas nuestras propiedades tienen escritura y son de <strong>dominio pleno</strong> — podés venderlas cuando quieras. Añelo ha mostrado una valorización constante al ritmo del desarrollo de Vaca Muerta. Muchos inversores eligen mantenerlas por la renta y eventualmente vender con plusvalía acumulada.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">¿Qué gastos tengo como inversor?<span class="faq-icon" aria-hidden="true"></span></button>
        <div class="faq-a"><p>Los gastos habituales son impuestos (retributivos y rentas), mantenimiento, servicios y administración. Nos encargamos de mantener todo al día para que no tengas que ocuparte de nada.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">¿Cómo recibo mi renta mensual?<span class="faq-icon" aria-hidden="true"></span></button>
        <div class="faq-a"><p>La renta se transfiere mensualmente a tu cuenta bancaria. Los contratos corporativos se pactan en <strong>pesos con ajuste por IPC</strong> trimestral o cuatrimestral, según la extensión del contrato.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">¿Puedo invertir si soy de otra provincia?<span class="faq-icon" aria-hidden="true"></span></button>
        <div class="faq-a"><p>Sí, trabajamos con inversores de todo el país. Todo el proceso se puede gestionar de forma remota — vos tomás las decisiones, nosotros nos encargamos de los trámites en Añelo.</p></div>
      </div>
      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">¿Qué perspectiva tiene Vaca Muerta a largo plazo?<span class="faq-icon" aria-hidden="true"></span></button>
        <div class="faq-a"><p>Vaca Muerta es la <strong>2° reserva de shale del mundo</strong> y Argentina aún está en las etapas tempranas de su explotación masiva. Las inversiones de YPF, TotalEnergies, Shell y otros gigantes energéticos están proyectadas por décadas. Cada nueva licitación aumenta la demanda de alojamiento corporativo y la valorización del suelo en Añelo.</p></div>
      </div>
    </div>
    <div style="text-align:center; margin-top:2.5rem;">
      <a class="btn-primary" href="https://wa.me/5492972431619?text=Hola%2C%20reci%C3%A9n%20vi%20su%20sitio%20web%20y%20quisiera%20m%C3%A1s%20informaci%C3%B3n%20de%20las%20opciones%20disponibles%20para%20comprar." target="_blank" rel="noopener" onclick="gtag('event','whatsapp_click',{'event_category':'faq_cta'});gtag('event','conversion',{'send_to':'AW-17170667639/kKlFCJvU_JccEPewzvs_','value':1.0,'currency':'ARS'})">Tengo más preguntas — hablemos</a>
    </div>
  </section>

  <section style="background:var(--light); padding-top:4rem; padding-bottom:4rem;">
    <div class="section-label reveal">Proceso de compra</div>
    <div class="section-title reveal">Invertir en <em>4 pasos</em></div>
    <div class="gold-divider reveal"></div>
    <div class="steps reveal">
      <div class="step"><div class="step-num" aria-hidden="true">01</div><h4>Elegís tu propiedad</h4><p>Te presentamos las opciones vigentes con perspectiva del mercado local y condiciones de cada operación.</p></div>
      <div class="step"><div class="step-num" aria-hidden="true">02</div><h4>Reserva y escritura</h4><p>Gestionamos toda la documentación legal. Escritura simple y transparente con estudio jurídico de confianza.</p></div>
      <div class="step"><div class="step-num" aria-hidden="true">03</div><h4>Conseguimos el inquilino</h4><p>Nos encargamos de encontrar el próximo inquilino corporativo, negociar las condiciones y firmar el contrato para que tu propiedad empiece a rendir.</p></div>
      <div class="step"><div class="step-num" aria-hidden="true">04</div><h4>Cobrás tu renta</h4><p>Mensualmente recibís el pago. Nosotros administramos, vos solo monitoréas tus ingresos.</p></div>
    </div>
  </section>
</Layout>

<script is:inline>
  // ─── FAQ ACCORDION ────────────────────────────────────────────────────
  (function() {
    document.querySelectorAll('.faq-q').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var item = btn.closest('.faq-item');
        var isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach(function(el) {
          el.classList.remove('open');
          el.querySelector('.faq-q').setAttribute('aria-expanded', 'false');
          var ans = el.querySelector('.faq-a');
          ans.style.maxHeight = '0';
        });
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
          var ans = item.querySelector('.faq-a');
          ans.style.maxHeight = ans.scrollHeight + 'px';
        }
      });
    });
  })();

  // ─── SCROLL-BUILD ANIMATION ────────────────────────────────────────────
  (function() {
    var section = document.getElementById('scrollBuild');
    if (!section) return;
    var svg = section.querySelector('.build-svg');
    var bricksG = document.getElementById('buildBricks');
    var stages = section.querySelectorAll('.build-stage');
    var pBar = section.querySelector('.build-progress-bar');

    if (bricksG && !bricksG.children.length) {
      var rows = 6, cols = 6;
      var bw = 36, bh = 16;
      var startX = 290, baseY = 325;
      var html = '';
      for (var r = 0; r < rows; r++) {
        for (var c = 0; c < cols; c++) {
          var x = startX + c * bw;
          var y = baseY - (r + 1) * bh;
          var s = 0.30 + (r / rows) * 0.21 + (c / cols) * 0.012;
          html += '<rect class="brick" x="' + x + '" y="' + y + '" width="' + (bw - 1) + '" height="' + (bh - 1) + '" style="--s:' + s.toFixed(3) + '"/>';
        }
      }
      bricksG.innerHTML = html;
    }

    var ticking = false;
    var lastStage = -1;

    function update() {
      if (!section.offsetParent) { ticking = false; return; }
      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight;
      var sectionH = section.offsetHeight;
      var scrollable = sectionH - vh;
      if (scrollable <= 0) { ticking = false; return; }
      var distance = 70 - rect.top;
      var p = Math.min(1, Math.max(0, distance / scrollable));
      svg.style.setProperty('--p', p.toFixed(4));
      if (pBar) pBar.style.setProperty('--p', p.toFixed(4));

      var idx;
      if (p < 0.13) idx = 0;
      else if (p < 0.28) idx = 1;
      else if (p < 0.54) idx = 2;
      else if (p < 0.70) idx = 3;
      else if (p < 0.88) idx = 4;
      else idx = 5;

      if (idx !== lastStage) {
        stages.forEach(function(s, i) {
          s.classList.toggle('active', i === idx);
          s.classList.toggle('done', i < idx);
        });
        lastStage = idx;
      }
      ticking = false;
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  })();
</script>
