          <div class="prop-img-wrap"
            data-images={JSON.stringify(p.images?.length > 1 ? p.images : [p.cover_image])}
            data-positions={JSON.stringify(
              (p.images?.length > 1 ? p.images : [p.cover_image]).map((url: string, i: number) =>
                url === p.cover_image
                  ? ((p.image_positions ?? [])[i] ?? p.cover_position ?? '50% 50%')
