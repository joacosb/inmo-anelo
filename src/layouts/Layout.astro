---
import '../styles/global.css';
import { getImageUrl } from '../lib/supabase';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import PropertyModal from '../components/PropertyModal.astro';
import ServicesModal from '../components/ServicesModal.astro';

export interface Props {
  title: string;
  description: string;
  pathname: string;
  ogImage?: string;
  preloadHero?: boolean;
  /** Primera imagen visible del hero (LCP) — se precarga optimizada en desktop. */
  heroImage?: string;
}

const { title, description, pathname, ogImage = 'https://qwhasgdxhvdavnofmisf.supabase.co/storage/v1/object/public/property-images/hero/maria-i.webp', preloadHero = false, heroImage } = Astro.props;
const site = 'https://inmobiliariaanelo.com.ar';
const canonical = site + pathname;
const fullOg = ogImage.startsWith('http') ? ogImage : site + ogImage;

const navItems = [
  { href: '/', label: 'Inicio', match: '/' },
  { href: '/corporativo/', label: 'Alquiler Corporativo', match: '/corporativo/' },
  { href: '/invertir/', label: 'Invertir', match: '/invertir/' },
  { href: '/nosotros/', label: 'Nosotros', match: '/nosotros/' },
  { href: '/contacto/', label: 'Contacto', match: '/contacto/', cta: true },
];
---
<!DOCTYPE html>
<html lang="es-AR">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-0XLBKV85QF"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-0XLBKV85QF');
    gtag('config', 'AW-17170667639');
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ═══ PRIMARY SEO ═══ -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="alquiler corporativo Añelo, inmobiliaria Añelo Neuquén, inversión Vaca Muerta, alquiler Oil Gas Neuquén, complejos corporativos Añelo, departamentos Añelo, inversión inmobiliaria Patagonia, alquiler empresas Vaca Muerta, Grupo Pampa inmobiliaria" />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="author" content="Inmobiliaria Añelo – Grupo Pampa" />
  <link rel="canonical" href={canonical} />

  <!-- ═══ GOOGLE SEARCH CONSOLE ═══ -->
  <meta name="google-site-verification" content="l5EaZ3LATjVHVcCWjnhRTw3EuVLDahLNI5kPrpvQRmA" />

  <!-- ═══ FAVICON & PWA ═══ -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/logo-inmobiliaria-anelo.png" />
  <link rel="apple-touch-icon" href="/logo-inmobiliaria-anelo.png" />
  <meta name="theme-color" content="#1B1B18" />

  <!-- ═══ GEO / LOCAL SEO ═══ -->
  <meta name="geo.region" content="AR-Q" />
  <meta name="geo.placename" content="Añelo, Neuquén, Argentina" />
  <meta name="geo.position" content="-38.354;-68.783" />
  <meta name="ICBM" content="-38.354, -68.783" />
  <meta name="language" content="es-AR" />

  <!-- ═══ OPEN GRAPH · Facebook & Meta Ads ═══ -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Inmobiliaria Añelo" />
  <meta property="og:locale" content="es_AR" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOg} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Inmobiliaria Añelo, Vaca Muerta, Neuquén" />

  <!-- ═══ TWITTER / X CARD ═══ -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOg} />

  <!-- ═══ SCHEMA.ORG JSON-LD ═══ -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "RealEstateAgent",
        "@id": "https://inmobiliariaanelo.com.ar/#organization",
        "name": "Inmobiliaria Añelo",
        "alternateName": "Grupo Pampa Inmobiliaria",
        "url": "https://inmobiliariaanelo.com.ar/",
        "logo": { "@type": "ImageObject", "url": "https://inmobiliariaanelo.com.ar/logo-inmobiliaria-anelo.png" },
        "image": "https://inmobiliariaanelo.com.ar/complejo-yellowstone.webp",
        "description": "Inmobiliaria especializada en alquiler corporativo para empresas Oil & Gas e inversiones inmobiliarias en Añelo, Neuquén, Vaca Muerta. Complejos, edificios y unidades funcionales totalmente equipadas. +25 años de trayectoria en la Patagonia.",
        "telephone": "+5492944486303",
        "email": "grupopampanqn@gmail.com",
        "sameAs": ["https://www.instagram.com/inmobiliaria.anelo"],
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Vaca Muerta 8305",
          "addressLocality": "Añelo",
          "addressRegion": "Neuquén",
          "postalCode": "8305",
          "addressCountry": "AR"
        },
        "geo": { "@type": "GeoCoordinates", "latitude": -38.354, "longitude": -68.783 },
        "openingHoursSpecification": [
          { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "18:00" },
          { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "09:00", "closes": "13:00" }
        ],
        "priceRange": "USD 35.000 – USD 500.000",
        "areaServed": {
          "@type": "City", "name": "Añelo",
          "containedInPlace": { "@type": "State", "name": "Neuquén", "containedInPlace": { "@type": "Country", "name": "Argentina" } }
        },
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Propiedades en Alquiler e Inversión – Vaca Muerta",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Alquiler Corporativo Oil & Gas – Complejos de Casas", "description": "Complejos residenciales completos para personal de empresas Oil & Gas en Añelo, Neuquén." } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Inversión en Edificios – Vaca Muerta", "description": "Edificios de departamentos en el centro de Añelo. Retorno 9–12% anual en USD." } },
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Unidades Funcionales para Inversores", "description": "Departamentos individuales en Añelo desde USD 35.000. Gestión integral incluida." } }
          ]
        }
      },
      {
        "@type": "WebSite",
        "@id": "https://inmobiliariaanelo.com.ar/#website",
        "url": "https://inmobiliariaanelo.com.ar/",
        "name": "Inmobiliaria Añelo",
        "description": "Alquiler corporativo e inversión inmobiliaria en Vaca Muerta, Añelo, Neuquén",
        "publisher": { "@id": "https://inmobiliariaanelo.com.ar/#organization" },
        "inLanguage": "es-AR"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "¿Cuánto cuesta alquilar un complejo corporativo en Añelo?", "acceptedAnswer": { "@type": "Answer", "text": "El precio depende del tamaño y tipo de complejo. Trabajamos con contratos corporativos en USD a nombre de la empresa operadora. Cotizá en menos de 24 horas completando el formulario." } },
          { "@type": "Question", "name": "¿Qué retorno anual ofrece invertir en Vaca Muerta?", "acceptedAnswer": { "@type": "Answer", "text": "Las propiedades en Añelo, Neuquén ofrecen retornos del 10 al 12% anual en dólares, respaldados por contratos corporativos con empresas Oil & Gas de primer nivel." } },
          { "@type": "Question", "name": "¿Qué incluye el alquiler corporativo?", "acceptedAnswer": { "@type": "Answer", "text": "Incluye gestión integral, servicios (electricidad, agua, gas, internet, DirecTV), mantenimiento y administración. La empresa operadora paga directamente en USD." } },
          { "@type": "Question", "name": "¿Desde cuánto se puede invertir en propiedades en Añelo?", "acceptedAnswer": { "@type": "Answer", "text": "Se puede ingresar desde USD 35.000 en unidades funcionales individuales, hasta inversiones mayores en complejos o edificios completos." } }
        ]
      }
    ]
  })} />

  {preloadHero && heroImage && (
    <link
      rel="preload"
      as="image"
      href={getImageUrl(heroImage, { width: 1920, quality: 65 })}
      fetchpriority="high"
      media="(min-width: 769px)"
    />
  )}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" /></noscript>
</head>
<body>

<Navbar pathname={pathname} />

<div class="pt-[var(--nav-h)]">
  <slot />
</div>

<Footer />

<PropertyModal />
<ServicesModal />
<WhatsAppFloat />

<!-- GLOBAL SCRIPTS -->
<script is:inline>
  // ─── TICKER: pausar animación cuando no está en pantalla ──────────────────
  (function() {
    if (!('IntersectionObserver' in window)) return;
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        var track = e.target.querySelector('.ticker-track');
        if (track) track.style.animationPlayState = e.isIntersecting ? 'running' : 'paused';
      });
    }, { threshold: 0 });
    document.querySelectorAll('.ticker-bar').forEach(function(el) { obs.observe(el); });
  })();

  // ─── REVEAL ON SCROLL ──────────────────────────────────────────────────
  (function() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(function(el) { io.observe(el); });
  })();
</script>

<script src="https://unpkg.com/lucide@0.454.0/dist/umd/lucide.min.js" is:inline></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.lucide) lucide.createIcons();
  });
</script>
</body>
</html>
