---
interface Props {
  title: string;
  section?: string;
}
const { title, section = '' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · Admin Inmobiliaria Añelo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --brand-black: #1B1B18;
      --brand-card: #242420;
      --brand-gold: #c9a84c;
      --brand-gold-light: #e8c97a;
      --font-display: 'Cormorant Garamond', serif;
      --font-body: 'Montserrat', sans-serif;
    }
    body {
      font-family: var(--font-body);
      background: var(--brand-black);
      color: #ffffff;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* ── LAYOUT ── */
    .adm-layout { display: flex; min-height: 100vh; }

    /* ── SIDEBAR ── */
    .adm-sidebar {
      width: 220px;
      flex-shrink: 0;
      background: #141412;
      border-right: 1px solid rgba(201,168,76,.2);
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      box-shadow: 4px 0 24px rgba(0,0,0,.4);
    }
    .adm-sidebar-brand {
      padding: 1.5rem 1.25rem 1.25rem;
      border-bottom: 1px solid rgba(255,255,255,.08);
      display: flex;
      align-items: center;
      gap: .75rem;
    }
    .adm-brand-icon {
      width: 36px;
      height: 36px;
      object-fit: contain;
      filter: drop-shadow(0 2px 6px rgba(201,168,76,.3));
    }
    .adm-sidebar-logo {
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--brand-gold);
      line-height: 1.1;
    }
    .adm-sidebar-name {
      font-family: var(--font-display);
      font-size: 1.35rem;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: .04em;
      line-height: 1.1;
    }
    .adm-sidebar-sub {
      font-size: .56rem;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: rgba(255,255,255,.35);
      margin-top: .15rem;
    }

    /* ── NAV ── */
    .adm-nav { flex: 1; padding: 1rem 0; }
    .adm-nav-section {
      font-size: .55rem;
      font-weight: 700;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--brand-gold);
      padding: 1.1rem 1.25rem .4rem;
      opacity: .8;
    }
    .adm-nav-link {
      display: flex;
      align-items: center;
      gap: .65rem;
      padding: .65rem 1.25rem;
      font-size: .78rem;
      font-weight: 600;
      color: rgba(255,255,255,.6);
      text-decoration: none;
      transition: color .2s, background .2s, border-color .2s;
      border-left: 3px solid transparent;
    }
    .adm-nav-link:hover { color: #ffffff; background: rgba(255,255,255,.04); }
    .adm-nav-link.active {
      color: var(--brand-gold);
      background: rgba(201,168,76,.12);
      border-left-color: var(--brand-gold);
      font-weight: 700;
    }

    /* ── SIDEBAR FOOTER ── */
    .adm-sidebar-footer {
      padding: .8rem 0;
      border-top: 1px solid rgba(255,255,255,.08);
      background: rgba(0,0,0,.2);
    }
    .adm-sidebar-footer a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .5rem 1.25rem;
      font-size: .72rem;
      font-weight: 500;
      color: rgba(255,255,255,.45);
      text-decoration: none;
      transition: color .2s, background .2s;
    }
    .adm-sidebar-footer a:hover { color: #ffffff; background: rgba(255,255,255,.04); }

    /* ── CONTENT ── */
    .adm-content { flex: 1; min-width: 0; overflow-x: hidden; background: var(--brand-black); }

    /* ── MOBILE: sidebar → top bar ── */
    @media (max-width: 768px) {
      .adm-layout { flex-direction: column; }
      .adm-sidebar {
        width: 100%;
        height: auto;
        position: sticky;
        top: 0;
        z-index: 100;
        flex-direction: row;
        align-items: center;
        overflow-x: auto;
        overflow-y: visible;
        border-right: none;
        border-bottom: 1px solid rgba(201,168,76,.3);
        box-shadow: 0 4px 20px rgba(0,0,0,.5);
      }
      .adm-sidebar-brand {
        border-bottom: none;
        border-right: 1px solid rgba(255,255,255,.08);
        padding: .75rem 1rem;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .adm-sidebar-sub { display: none; }
      .adm-nav { flex: none; display: flex; align-items: center; padding: 0; }
      .adm-nav-section { display: none; }
      .adm-nav-link { padding: .8rem 1rem; white-space: nowrap; border-left: none; border-bottom: 3px solid transparent; }
      .adm-nav-link.active { border-left-color: transparent; border-bottom-color: var(--brand-gold); }
      .adm-sidebar-footer { display: flex; align-items: center; border-top: none; border-left: 1px solid rgba(255,255,255,.08); padding: 0; margin-left: auto; flex-shrink: 0; }
      .adm-sidebar-footer a { padding: .8rem 1rem; white-space: nowrap; }
    }
  </style>
</head>
<body>
  <div class="adm-layout">
    <aside class="adm-sidebar">
      <div class="adm-sidebar-brand">
        <img src="/favicon.svg" alt="IA Logo" class="adm-brand-icon" width="36" height="36" />
        <div>
          <div class="adm-sidebar-logo">Inmobiliaria</div>
          <div class="adm-sidebar-name">AÑELO</div>
          <div class="adm-sidebar-sub">Admin Panel</div>
        </div>
      </div>
      <nav class="adm-nav">
        <a href="/admin/dashboard/" class={`adm-nav-link${section === 'dashboard' ? ' active' : ''}`}>
          <span>Dashboard</span>
        </a>
        <div class="adm-nav-section">Contenido</div>
        <a href="/admin/propiedades/" class={`adm-nav-link${section === 'propiedades' ? ' active' : ''}`}>
          <span>Propiedades</span>
        </a>
        <a href="/admin/homepage/" class={`adm-nav-link${section === 'homepage' ? ' active' : ''}`}>
          <span>Portafolio Homepage</span>
        </a>
      </nav>
      <div class="adm-sidebar-footer">
        <a href="/" target="_blank">Ver sitio ↗</a>
        <a href="/admin/logout/">Cerrar sesión</a>
      </div>
    </aside>
    <div class="adm-content">
      <slot />
    </div>
  </div>
</body>
</html>
